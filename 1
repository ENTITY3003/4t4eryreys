def analyze_js_source(text: str, where: str) -> List[Tuple[str, str, str, str, str]]:
    """Return list of (pattern_id, title, severity, evidence, remediation+cwe)."""
    hits = []
    sample = text[:400_000]
    for pid, rx, title, sev, fix, cwe in JS_PATTERNS:
        if title is None:
            continue
        m = rx.search(sample)
        if m:
            frag = m.group(0)
            # SAFETY: never record secret VALUES. For credential-style hits
            # keep only the key NAME; for behavioural sinks keep a short
            # code fragment (they contain no secrets by nature).
            if pid in ("js-hardcoded-key", "js-aws-key", "js-jwt",
                       "js-private-key-block"):
                frag = re.split(r"[:=]", frag, 1)[0].strip() + " = <REDACTED>"
            elif len(frag) > 70:
                frag = frag[:70] + "…"
            hits.append((pid, title, sev,
                         f"{where}: {frag}", f"{fix} [{cwe}]" if cwe else fix))
    return hits


def sourcemap_url(text: str) -> Optional[str]:
    m = re.search(r"//#\s*sourceMappingURL=(\S+)", text[-2000:])
    return m.group(1) if m else None


