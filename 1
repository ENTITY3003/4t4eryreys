def osv_lookup(pkg_ecosystem: str, pkg_name: str, version: str,
               throttle: Optional[Throttle] = None) -> List[Dict[str, Any]]:
    """Query Google OSV.dev API (free, no auth) for vulnerabilities
    affecting an exact package version. Advisory-only; returns CVE ids."""
    body = json.dumps({
        "query": {"package": {"name": pkg_name,
                              "ecosystem": pkg_ecosystem},
                  "version": version}}).encode()
    if throttle is not None:
        throttle.wait()
    try:
        s = requests.Session()
        s.headers.update({"User-Agent": UA,
                          "Content-Type": "application/json"})
        r = s.post("https://api.osv.dev/v1/query", data=body, timeout=12.0)
        if r.status_code != 200:
            return []
        out = []
        for v in r.json().get("vulns", [])[:40]:
            aliases = [a for a in v.get("aliases", []) if a.startswith("CVE-")]
            sev = ""
            for x in v.get("severity", []):
                if x.get("type") == "CVSS_V3":
                    sev = x.get("score", "")
            out.append({
                "id": v.get("id"), "cves": aliases,
                "summary": (v.get("summary") or "")[:160],
                "cvss": sev,
                "link": f"https://osv.dev/vulnerability/{v.get('id')}",
            })
        return out
    except Exception:
        return []


def osv_purl_query(purl: str, throttle: Optional[Throttle] = None
                   ) -> List[Dict[str, Any]]:
    """OSV batch query by Package URL string (pkg:npm/express@4.17.1...)."""
    body = json.dumps({"query": {"package": {"purl": purl}}}).encode()
    if throttle is not None:
        throttle.wait()
    try:
        s = requests.Session()
        s.headers.update({"User-Agent": UA,
                          "Content-Type": "application/json"})
        r = s.post("https://api.osv.dev/v1/query", data=body, timeout=12.0)
        if r.status_code == 200:
            return r.json().get("vulns", [])[:40]
    except Exception:
        pass
    return []


