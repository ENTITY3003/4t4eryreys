        self._poll()

    # ---------- UI ----------
    def _build(self):
        tk, ttk = self.tk, self.ttk
        style = ttk.Style(self.root)
        try:
            style.theme_use("clam")
        except Exception:
            pass
        style.configure("Dark.TFrame", background="#0f172a")
        style.configure("Dark.TLabel", background="#0f172a", foreground="#e2e8f0")
        style.configure("Accent.TButton", font=("Segoe UI", 10, "bold"))

        top = ttk.Frame(self.root, style="Dark.TFrame")
        top.pack(fill="x", padx=10, pady=8)
        ttk.Label(top, text="Target:", style="Dark.TLabel").grid(row=0, column=0, sticky="w")
        self.ent_target = ttk.Entry(top, width=52, font=("Consolas", 11))
        self.ent_target.grid(row=0, column=1, padx=6)
        self.ent_target.insert(0, "https://example.com")
        self.btn_scan = ttk.Button(top, text="\u25b6  Start Scan",
                                   style="Accent.TButton", command=self.start_scan)
        self.btn_scan.grid(row=0, column=2, padx=4)
        self.btn_stop = ttk.Button(top, text="\u25a0 Stop", command=self.stop_scan,
                                   state="disabled")
        self.btn_stop.grid(row=0, column=3, padx=4)
        self.btn_pdf = ttk.Button(top, text="\U0001f4c4 Export PDF",
                                  command=self.export_pdf, state="disabled")
        self.btn_pdf.grid(row=0, column=4, padx=4)

        opts = ttk.Frame(top, style="Dark.TFrame")
        opts.grid(row=1, column=0, columnspan=5, sticky="w", pady=(6, 0))
        self.var_verify = tk.BooleanVar(value=True)
        self.var_deep = tk.BooleanVar(value=False)
        self.var_rate = tk.IntVar(value=2)
        ttk.Checkbutton(opts, text="Verify findings (double-check)",
                        variable=self.var_verify).pack(side="left", padx=6)
        ttk.Checkbutton(opts, text="Extended port range 1\u20131024 (slow)",
                        variable=self.var_deep).pack(side="left", padx=6)
        ttk.Label(opts, text="Rate limit (req/s):",
                  style="Dark.TLabel").pack(side="left", padx=(12, 2))
        tk.Scale(opts, from_=1, to=10, orient="horizontal", length=120,
                 showvalue=True, variable=self.var_rate, bg="#0f172a",
                 fg="#e2e8f0", highlightthickness=0).pack(side="left")

        pbframe = ttk.Frame(self.root, style="Dark.TFrame")
        pbframe.pack(fill="x", padx=10)
        self.pb = ttk.Progressbar(pbframe, mode="determinate", maximum=100)
        self.pb.pack(fill="x", pady=4)
        self.lbl_status = ttk.Label(pbframe, text="Idle.", style="Dark.TLabel")
        self.lbl_status.pack(anchor="w")

        main = ttk.Panedwindow(self.root, orient="vertical")
        main.pack(fill="both", expand=True, padx=10, pady=6)
        ft = ttk.Frame(main, style="Dark.TFrame")
        main.add(ft, weight=3)
        cols = ("sev", "cat", "title", "conf", "ver", "target")
        heads = ("SEV", "CATEGORY", "FINDING", "CONF%", "VERIFIED", "TARGET")
        widths = (70, 100, 480, 55, 70, 220)
        self.tree = ttk.Treeview(ft, columns=cols, show="headings", height=12)
        for c, h, w in zip(cols, heads, widths):
            self.tree.heading(c, text=h)
            self.tree.column(c, width=w, anchor="w")
        for s, bg in SEV_BG.items():
            self.tree.tag_configure(s, background=bg, foreground="white")
        vsb = ttk.Scrollbar(ft, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=vsb.set)
        self.tree.pack(side="left", fill="both", expand=True)
        vsb.pack(side="right", fill="y")
        self.tree.bind("<Double-1>", self.show_detail)

        lg = ttk.Frame(main, style="Dark.TFrame")
        main.add(lg, weight=2)
        self.txt_log = tk.Text(lg, height=12, bg="#020617", fg="#94a3b8",
                               insertbackground="#94a3b8", font=("Consolas", 9),
                               state="disabled")
        self.txt_log.pack(fill="both", expand=True)

        stats = ttk.Frame(self.root, style="Dark.TFrame")
        stats.pack(fill="x", padx=10, pady=(0, 8))
        self.lbl_counts = {}
        for sev in ("critical", "high", "medium", "low", "info"):
            f = ttk.Frame(stats, style="Dark.TFrame")
            f.pack(side="left", padx=8)
            tk.Canvas(f, width=12, height=12, bg=SEV_BG[sev],
                      highlightthickness=0).pack(side="left")
            lbl = ttk.Label(f, text=f" {sev}: 0", style="Dark.TLabel")
            lbl.pack(side="left")
            self.lbl_counts[sev] = lbl

    # ---------- actions ----------
    def start_scan(self):
        from tkinter import messagebox
        target = self.ent_target.get().strip()
        if not target or target == "https://example.com":
            messagebox.showwarning("Input", "Enter a real target URL/IP first.")
            return
        if not messagebox.askyesno("Authorized use", CONSENT):
            return
        self.findings.clear()
        self.log_lines.clear()
        for i in self.tree.get_children():
            self.tree.delete(i)
        self.btn_scan.config(state="disabled")
        self.btn_stop.config(state="normal")
        self.btn_pdf.config(state="disabled")
        self.pb["value"] = 0
        self.lbl_status.config(text="Scanning\u2026")
        self.scanner = DentistScanner(
            target,
            log=lambda m: self.q.put(("log", m)),
            emit=lambda f: self.q.put(("finding", f)),
            progress=lambda p: self.q.put(("progress", p)),
            rps=float(self.var_rate.get()),
            workers=4,
            verify=self.var_verify.get(),
            deep_portscan=self.var_deep.get(),
        )
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        try:
            self.scanner.run()
        except Exception as e:
            self.q.put(("log", f"FATAL: {e}"))
        self.q.put(("done", None))

    def stop_scan(self):
        if self.scanner:
            self.scanner.stop()
            self.q.put(("log", "Stop requested by operator."))

    # ---------- queue pump ----------
    def _poll(self):
        try:
            while True:
                kind, payload = self.q.get_nowait()
                if kind == "log":
                    self._append_log(payload)
                elif kind == "finding":
                    self._add_finding(payload)
                elif kind == "progress":
                    self.pb["value"] = float(payload) * 100
                elif kind == "done":
                    self._finish()
        except queue.Empty:
            pass
        self.root.after(80, self._poll)

    def _append_log(self, msg: str):
        line = f"[{datetime.now():%H:%M:%S}] {msg}"
        self.log_lines.append(line)
        self.txt_log.config(state="normal")
        self.txt_log.insert("end", line + "\n")
        self.txt_log.see("end")
        self.txt_log.config(state="disabled")

    def _add_finding(self, f: Finding):
        self.findings.append(f)
        self.tree.insert("", "end", tags=(f.severity,), values=(
            f.severity.upper(), f.category, f.title, f.confidence,
            "\u2713" if f.verified else "?", _host_of(f.target)))
        self._refresh_counts()

    def _refresh_counts(self):
        counts = {}
        for f in self.findings:
            counts[f.severity] = counts.get(f.severity, 0) + 1
        for sev, lbl in self.lbl_counts.items():
            lbl.config(text=f" {sev}: {counts.get(sev, 0)}")

    def _finish(self):
        self.btn_scan.config(state="normal")
        self.btn_stop.config(state="disabled")
        dur = getattr(self.scanner, "duration", 0)
        reqs = self.scanner.stats["requests"] if self.scanner else 0
        self.pb["value"] = 100
        self.lbl_status.config(
            text=f"Finished in {dur:.1f}s | {len(self.findings)} findings | "
                 f"{reqs} requests (read-only)")
        if self.findings:
            self.btn_pdf.config(state="normal")

    def show_detail(self, _ev):
        tk = self.tk
        sel = self.tree.selection()
        if not sel:
            return
        idx = self.tree.index(sel[0])
        if idx >= len(self.findings):
            return
        f = self.findings[idx].to_dict()
        w = tk.Toplevel(self.root)
        w.title(f["title"][:80])
        w.geometry("640x420")
        txt = tk.Text(w, wrap="word", font=("Consolas", 10), bg="#020617",
                      fg="#e2e8f0")
        txt.pack(fill="both", expand=True)
        for k in ("category", "severity", "confidence", "verified",
                  "description", "evidence", "remediation", "cwe", "target"):
            txt.insert("end", f"{k.upper()}: {f.get(k)}\n\n")
        txt.config(state="disabled")

    def export_pdf(self):
        from tkinter import filedialog, messagebox
        if not self.findings:
            return
        default = f"h303_report_{datetime.now():%Y%m%d_%H%M%S}.pdf"
        path = filedialog.asksaveasfilename(
            title="Save PDF report", defaultextension=".pdf",
            initialfile=default, filetypes=[("PDF", "*.pdf")])
        if not path:
            return
        meta = {
            "target": self.scanner.target if self.scanner else "",
            "generated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "duration": getattr(self.scanner, "duration", 0),
            "requests": self.scanner.stats["requests"] if self.scanner else 0,
        }
        findings = [f.to_dict() for f in
                    sorted(self.findings, key=lambda x: -SEV_ORDER[x.severity])]
        try:
            build_pdf(findings, meta, self.log_lines, path)
            jpath = os.path.splitext(path)[0] + ".json"
            with open(jpath, "w", encoding="utf-8") as fh:
                json.dump({"meta": meta, "findings": findings}, fh,
                          ensure_ascii=False, indent=2)
            messagebox.showinfo("Report", f"PDF saved:\n{path}\nJSON saved:\n{jpath}")
        except Exception as e:
            messagebox.showerror("Report failed", str(e))


def _host_of(url: str) -> str:
    try:
        return urlparse(url).netloc or url
    except Exception:
        return url


