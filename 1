def _redact_frag(frag: str) -> str:
    frag = frag.strip().replace("\n", "\\n")
    if len(frag) > 90:
        frag = frag[:90] + "…"
    return frag


def deep_analyze_js(text: str, where: str) -> List["Finding"]:
    """Token-aware review of one JS source. Returns Finding objects (not added)."""
    findings: List[Finding] = []
    sample = text[:600_000]
    stripped = _js_strip_comments(sample)

    def mk(pid, sev, title, ev, fix="", cwe=""):
        findings.append(Finding(
            "JS-Review", pid, title, sev, 75,
            evidence=f"{where}: {_redact_frag(ev)}",
            remediation=fix, cwe=cwe))

    # secrets — scan BOTH raw and comment-stripped text (comments hide keys too)
    hit_ids = set()
    for src_name, src_text in (("raw", sample), ("code", stripped)):
        for sid, sev, rx, desc in SECRET_DETECTIONS:
            m = rx.search(src_text)
            if not m:
                continue
            if (sid, where) in hit_ids:
                continue
            hit_ids.add((sid, where))
            frag = m.group(0)
            # NEVER record secret VALUES — keep only the name prefix
            safe = re.split(r"[:=]", frag, 1)[0].strip()
            safe = re.sub(r"[A-Za-z0-9+/_\-]{8,}", "<REDACTED>", safe)[:70]
            mk(sid, sev, desc, f"{safe} = <REDACTED> ({src_name})",
               "Move secret server-side and rotate it immediately.", "CWE-798")

    for sid, sev, rx, desc, cwe in SINK_DETECTIONS:
        m = rx.search(stripped)
        if m:
            mk(sid, sev, desc, m.group(0), "", cwe)

    for oid, sev, rx, desc in OBFUSCATION_DETECTIONS:
        m = rx.search(stripped)
        if m:
            mk(oid, sev, desc, m.group(0)[:60],
               "Minify intentionally; de-obfuscate before shipping.", "")

    # library fingerprints & outdated versions
    for lid, rx, libname in LIB_FINGERPRINTS:
        m = rx.search(sample)
        if not m:
            continue
        ver = next((g for g in m.groups() if g), "")
        if libname in OLD_LIB_THRESHOLDS and ver:
            try:
                parts = [int(x) for x in ver.split(".")[:3]]
                parts += [0] * (3 - len(parts))
                vt = tuple(parts)
            except ValueError:
                vt = (999, 999, 999)
            th = OLD_LIB_THRESHOLDS[libname][0]
            if vt < th:
                mk(lid + "-outdated", "medium",
                   f"Outdated library: {libname} {ver} "
                   f"(< {'.'.join(map(str, th))})",
                   f"{libname} {ver}", OLD_LIB_THRESHOLDS[libname][1],
                   "CWE-1104")
            else:
                mk(lid, "info", f"Client library detected: {libname} {ver}",
                   f"{libname} {ver}")
        else:
            mk(lid, "info",
               f"Client library detected: {libname}" + (f" {ver}" if ver else ""),
               f"{libname} {ver}")

    # API endpoints referenced in client code
    eps = set()
    for m in API_ENDPOINT_RE.finditer(stripped):
        u = m.group(1)
        if len(u) > 8:
            eps.add(u[:100])
    if eps:
        listing = sorted(eps)
        mk("api-endpoints-exposed", "info",
           f"{len(listing)} internal API endpoint(s) referenced in client code",
           ", ".join(listing[:8]),
           "Ensure these endpoints enforce authz server-side (IDOR/BAC checks).",
           "CWE-200")

    dm = re.search(r"(?i)\b(?:DEBUG|DEV_MODE|IS_DEV|EXCEPTION_DEBUGGING|"
                   r"SHOW_ERRORS)\s*[:=]\s*(true|1)\b", stripped)
    if dm:
        mk("debug-flag-enabled", "medium",
           f"Debug flag left enabled in client bundle: {dm.group(1)}",
           dm.group(0), "Strip debug flags at build time.", "CWE-489")

    if re.search(r"console\.(?:table|dir)\s*\(", stripped):
        mk("console-structure-dump", "info",
           "console.table/dir dumps object structure in production",
           "console.table/dir()", "Remove verbose logging from builds.", "")

    ie = re.search(r"\b(?:setTimeout|setInterval)\s*\(\s*"
                  r"(?:atob|unescape|decodeURIComponent)\s*\(", stripped)
    if ie:
        mk("indirect-eval-decoder", "high",
           "Timer fed by decoder function (atob/unescape) — classic malicious "
           "pattern", ie.group(0),
           "Verify this code's provenance; replace with static callbacks.",
           "CWE-95")

    sm = re.search(r"//[#@]\s*sourceMappingURL=(\S+)", sample[-3000:])
    if sm:
        mk("sourcemap-reference", "info",
           "Source-map reference present in served JS", sm.group(0),
           "Check whether the .map file is publicly downloadable.", "")

    # string-literal sweep for credential-shaped blobs inside data
    for val, ln in _js_find_strings(stripped)[:4000]:
        if TOKEN_ASSIGN_RE.search(val) and re.search(r"[=:]", val) \
                and len(val) > 24:
            mk("credential-shaped-string", "medium",
               f"Credential-shaped string literal near line {ln}",
               re.sub(r"[A-Za-z0-9+/_\-]{8,}", "<REDACTED>", val[:60]),
               "Rotate anything that looks like a live credential.", "CWE-798")
            break
    return findings


# ─────────────────────────────────────────────────────────────────────
# HTML / form review engine — reads markup like an X-ray.
# ─────────────────────────────────────────────────────────────────────
FORM_TAG_RE = re.compile(r"<form\b[^>]*>(.*?)</form>", re.S | re.I)
ANY_TAG_ATTR_RE = re.compile(r"<([a-z0-9]+)\b([^>]*)>", re.I)
ATTR_SPLIT_RE = re.compile(
    r"([a-z0-9_:.-]+)\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s\"'>]+))", re.I)
ON_EVENT_RE = re.compile(r"^on[a-z]{3,}$")
INPUT_RE = re.compile(r"<input\b[^>]*>", re.I)
SELECT_RE = re.compile(r"<select\b[^>]*>(.*?)</select>", re.S | re.I)
OPTION_RE = re.compile(r"<option\b[^>]*value=[\"']([^\"']+)", re.I)
COMMENT_RE = re.compile(r"<!--(.*?)-->", re.S)
LOGIN_HINT_RE = re.compile(r"(?i)(password|passwd|pwd)")


def parse_attrs(tag_head: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    for m in ATTR_SPLIT_RE.finditer(tag_head):
        key = m.group(1).lower()
        val = next((g for g in m.groups()[1:] if g is not None), "")
        out[key] = val
    return out


def analyze_html_page(html_body: str, page_url: str) -> List["Finding"]:
    """Static review of one HTML document: forms, handlers, comments."""
    findings: List[Finding] = []
    body = html_body[:400_000]
    origin_host = urlparse(page_url).hostname or ""

    def push(cat, nid, title, sev, ev, fix, cwe="", conf=70, verified=False):
        findings.append(Finding(
            cat, nid, title, sev, confidence=conf, verified=verified,
            target=page_url, evidence=_redact_frag(ev),
            remediation=fix, cwe=cwe))

    # ---- forms ----
    for fm in FORM_TAG_RE.finditer(body):
        head_end = body.find(">", fm.start())
        if head_end == -1:
            continue
        head_attrs = parse_attrs(body[fm.start():head_end + 1])
        inner = fm.group(1)
        action = head_attrs.get("action", "")
        method = (head_attrs.get("method") or "get").lower()
        full_action = urljoin(page_url, action) if action else page_url
        fa_host = urlparse(full_action).hostname or ""
        if fa_host and fa_host != origin_host:
            push("Forms", "form-offsite-action",
                 f"Form submits to off-site host {fa_host}", "medium",
                 f"action={full_action[:120]} method={method}",
                 "Confirm third-party submission is intended; otherwise pin "
                 "action to same origin.", "CWE-346", 80, True)
        if full_action.lower().startswith("http://"):
            push("Forms", "form-cleartext-action",
                 "Form submits over cleartext http://", "medium",
                 full_action[:120], "Use https:// for every form action.",
                 "CWE-319", 90, True)
        input_tags = INPUT_RE.findall(inner)
        inputs = [parse_attrs(t) for t in input_tags]
        inputs = [a for a in inputs if a]
        has_pw = any(LOGIN_HINT_RE.search(a.get("name", "")) or
                     a.get("type", "").lower() == "password" for a in inputs)
        pw_field = next((a for a in inputs
                         if a.get("type", "").lower() == "password"), None)
        if pw_field:
            ac = pw_field.get("autocomplete", "").lower()
            if ac in ("off", "false", "new-password"):
                push("Forms", "pw-autocomplete-blocked",
                     "Password field discourages password managers "
                     f"(autocomplete={ac})", "info",
                     "password input declares autocomplete=\"" + ac + "\"",
                     "Use autocomplete=\"current-password\"/\"new-password\" "
                     "correctly; don't block managers.", "CWE-522", 70)
            elif "autocomplete" not in pw_field:
                push("Forms", "pw-autocomplete-unset",
                     "Password field lacks autocomplete guidance", "info",
                     "no autocomplete attribute on password input",
                     "Set autocomplete=\"new-password\"/\"current-password\".")
        tok = next((a for a in inputs if re.search(
            r"(?i)^(_?csrf[_-]?token|csrf|xsrf|authenticity_token|nonce|"
            r"__requestverificationtoken|securitytoken)$",
            a.get("name", ""))), None)
        if method == "post" and tok is None and not has_pw:
            push("Forms", "form-no-csrf-marker",
                 "POST form without recognizable CSRF token field", "medium",
                 f"action={full_action[:100]} fields="
                 f"{[a.get('name','') for a in inputs][:6]}",
                 "Add per-session anti-CSRF token or SameSite=Strict cookies.",
                 "CWE-352", 55)
        elif method == "post" and tok is not None and not tok.get("value"):
            push("Forms", "csrf-token-empty",
                 "CSRF-named field renders empty (server may not populate it)",
                 "medium", f"name={tok.get('name')}",
                 "Ensure the token is filled per session.", "CWE-352", 60)
        if method == "get" and has_pw:
            push("Forms", "credentials-over-get",
                 "Login-style form submitted via GET "
                 "(secrets land in URLs/logs/history)", "high",
                 "password field inside <form method=get>",
                 "Submit credentials only via POST over TLS.",
                 "CWE-598", 85, True)
        readonly_plain = [a for a in inputs
                          if "readonly" in a
                          and a.get("type", "text").lower() in ("text", "")]
        if readonly_plain:
            push("Forms", "readonly-input-client-trust",
                 f"{len(readonly_plain)} readonly text input(s) — read-only is "
                 "NOT a security control", "info",
                 "names: " + ", ".join(a.get("name", "?")
                                       for a in readonly_plain[:5]),
                 "Validate/override these values server-side.", "CWE-602", 60)
        hidden_vals = [a for a in inputs
                       if a.get("type", "").lower() == "hidden"
                       and re.search(r"(?i)(price|amount|role|admin|discount|"
                                     r"user_?id|account|balance|qty|quantity)",
                                     a.get("name", ""))]
        if hidden_vals:
            push("Forms", "hidden-business-field",
                 "Hidden input carries business-critical value "
                 "(tamper surface)", "medium",
                 "names: " + ", ".join(a.get("name", "?")
                                       for a in hidden_vals[:6]),
                 "Recompute price/role/ids server-side; never trust hidden "
                 "fields.", "CWE-602", 65)
        enum_opts = sum(len(OPTION_RE.findall(b))
                        for b in SELECT_RE.findall(inner))
        if enum_opts > 0:
            push("Forms", "enumerable-select-options",
                 f"{enum_opts} <option> value(s) enumerable from markup",
                 "info", "select fields expose option values",
                 "Confirm enumerated ids are not sensitive identifiers.",
                 "CWE-200", 55)

    # ---- inline event handlers ----
    inline_evts = []
    for tm in ANY_TAG_ATTR_RE.finditer(body):
        attrs = parse_attrs(tm.group(0))
        for k, v in attrs.items():
            if ON_EVENT_RE.match(k) and v.strip():
                inline_evts.append(f"<{tm.group(1)} {k}=…>")
    if inline_evts:
        push("Forms", "inline-event-handlers",
             f"{len(inline_evts)} inline on* event handler(s) in markup", "low",
             ", ".join(dict.fromkeys(inline_evts))[:250],
             "Attach listeners via addEventListener; keeps CSP 'unsafe-inline' "
             "out of your policy.", "CWE-79", 75)

    # ---- comments leaking internals ----
    leaky = []
    for cm in COMMENT_RE.finditer(body):
        txt = cm.group(1).strip()
        if len(txt) < 6:
            continue
        if re.search(r"(?i)(todo|fixme|hack|debug|password|api[_-]?key|token|"
                     r"internal|staging|temporar|server\s*:|db[_-]?host|secret)",
                     txt):
            leaky.append(txt[:120])
    if leaky:
        push("Exposure", "html-comment-leak",
             "HTML comment(s) disclose internal notes/markers", "low",
             " || ".join(leaky[:4])[:400],
             "Strip developer comments from production templates.",
             "CWE-615", 70)

    # ---- meta refresh / javascript: hrefs ----
    if re.search(r"<meta[^>]+http-equiv=[\"']refresh[\"'][^>]*url=", body, re.I):
        push("Forms", "meta-refresh", "META refresh redirect present", "info",
             "<meta http-equiv=refresh url=...>",
             "Prefer HTTP 3xx; ensure refresh target is validated.",
             "CWE-601", 70)
    js_hrefs = re.findall(r"href\s*=\s*[\"']javascript:", body, re.I)
    if js_hrefs:
        push("Forms", "javascript-href",
             f"{len(js_hrefs)} href=\"javascript:...\" link(s)", "low",
             "javascript: pseudo-URLs in anchors",
             "Use buttons + addEventListener.", "CWE-79", 80)

    # ---- reverse tabnabbing ----
    risky_links = []
    for tm in ANY_TAG_ATTR_RE.finditer(body):
        if tm.group(1).lower() != "a":
            continue
        attrs = parse_attrs(tm.group(0))
        href = attrs.get("href", "")
        tgt = attrs.get("target", "")
        rel = attrs.get("rel", "").lower()
        if tgt == "_blank" and href.startswith(("http://", "https://", "//")):
            h = urlparse(href if not href.startswith("//") else "https:" + href)
            if h.hostname and h.hostname != origin_host and "noopener" not in rel:
                risky_links.append(href[:60])
    if risky_links:
        push("Forms", "reverse-tabnabbing",
             f"{len(risky_links)} external target=_blank link(s) without "
             "rel=noopener", "low",
             ", ".join(dict.fromkeys(risky_links))[:250],
             "Add rel=\"noopener noreferrer\" to external _blank links.",
             "CWE-1022", 85, True)
    return findings


# ─────────────────────────────────────────────────────────────────────
# Header-policy parser mini-engine (CSP / HSTS / Expect-CT / COOP / COEP)
# ─────────────────────────────────────────────────────────────────────
def parse_csp(value: str) -> Dict[str, List[str]]:
    pol: Dict[str, List[str]] = {}
    for part in value.split(";"):
        toks = part.strip().split()
        if not toks:
            continue
        pol[toks[0].lower()] = [t.lower() for t in toks[1:]]
    return pol


def analyze_csp(value: str, url: str) -> List["Finding"]:
    out: List[Finding] = []
    pol = parse_csp(value)
    if not pol:
        return out

    def add(nid, sev, title, ev, fix, cwe, conf=85):
        out.append(Finding(
                "Headers", nid, title, sev, confidence=conf, verified=True,
                target=url, evidence=_redact_frag(ev),
                remediation=fix, cwe=cwe))

    default = pol.get("default-src", [])
    script = pol.get("script-src", default)
    style = pol.get("style-src", default)
    frame = pol.get("frame-src", pol.get("child-src", default))
    connect = pol.get("connect-src", default)
    obj = pol.get("object-src", default)
    if "'unsafe-inline'" in script:
        add("csp-unsafe-inline-scripts", "high",
            "CSP allows 'unsafe-inline' for scripts (XSS still possible)",
            f"script-src={' '.join(script)[:160]}",
            "Use nonces/hashes; drop unsafe-inline.", "CWE-1021")
    if "'unsafe-eval'" in script:
        add("csp-unsafe-eval", "medium", "CSP allows 'unsafe-eval'",
            f"script-src={' '.join(script)[:160]}",
            "Avoid eval-dependent libs (or their wasm builds).", "CWE-1021")
    if any(s == "*" for s in script):
        add("csp-wildcard-script", "high",
            "CSP script-src includes wildcard *",
            f"script-src={' '.join(script)[:160]}",
            "Pin script sources to specific hosts.", "CWE-1021")
    wildish = [s for s in script if s.startswith("*.")]
    if wildish:
        add("csp-wildcard-host", "medium",
            f"CSP trusts wildcard hosts: {', '.join(wildish[:4])}",
            "wildcard subdomains allowed",
            "Enumerate exact hosts you need.", "CWE-1021")
    if obj and "'none'" not in obj and "*" in obj:
        add("csp-object-wildcard", "medium",
            "object-src permits plugins broadly",
            f"object-src={' '.join(obj)}",
            "Set object-src 'none'.", "CWE-1021")
    if not obj and not default:
        add("csp-no-object-src", "low",
            "CSP lacks object-src AND default-src (plugins unrestricted)",
            "object-src absent", "Set object-src 'none'.", "CWE-1021", 65)
    if frame and ("*" in frame or any(f.startswith("*.") for f in frame)):
        add("csp-frame-wildcard", "medium",
            "frame/child-src allows wildcard embeds",
            f"frame-src={' '.join(frame)[:120]}",
            "Whitelist framing origins exactly.", "CWE-1021")
    if connect and "*" in connect:
        add("csp-connect-wildcard", "low",
            "connect-src wildcard lets exfil requests go anywhere",
            f"connect-src={' '.join(connect)[:120]}",
            "Restrict fetch/XHR destinations.", "CWE-1021", 70)
    if "report-to" not in pol and "report-uri" not in pol:
        add("csp-no-reporting", "info",
            "CSP has no report-uri/report-to endpoint",
            "violations won't be reported",
            "Enable Reporting-Endpoints for monitoring.", "", 60)
    if style and "*" in style:
        add("csp-style-wildcard", "info", "style-src wildcard",
            f"style-src={' '.join(style)[:120]}",
            "Scope CSS sources.", "CWE-1021", 55)
    if "base-uri" not in pol:
        add("csp-no-base-uri", "low", "CSP missing base-uri directive",
            "base-uri absent — <base> hijack vector",
            "Add base-uri 'self'.", "CWE-1021", 70)
    if "form-action" not in pol:
        add("csp-no-form-action", "low", "CSP missing form-action directive",
            "form-action absent — form retargeting vector",
            "Add form-action 'self'.", "CWE-1021", 70)
    if "upgrade-insecure-requests" not in pol and \
            "block-all-mixed-content" not in pol:
        add("csp-no-upgrade-insecure", "info",
            "CSP lacks upgrade-insecure-requests",
            "mixed content not auto-upgraded",
            "Add upgrade-insecure-requests.", "", 55)
    return out


def analyze_hsts_value(value: str, url: str) -> List["Finding"]:
    out: List[Finding] = []
    low = value.lower()
    m = re.search(r"max-age\s*=\s*(\d+)", low)
    age = int(m.group(1)) if m else 0
    if age < 15552000:
        out.append(Finding(
            "Headers", "hsts-short-max-age",
            f"HSTS max-age below 6 months ({age}s)", "low", 90, verified=True,
            target=url, evidence=_redact_frag(value),
            remediation="Use max-age=31536000; includeSubDomains; preload",
            cwe="CWE-693"))
    if "includesubdomains" not in low:
        out.append(Finding(
            "Headers", "hsts-no-subdomains",
            "HSTS missing includeSubDomains", "info", 75, verified=True,
            target=url, evidence=_redact_frag(value),
            remediation="Add includeSubDomains after auditing subdomains."))
    if "preload" not in low and age >= 31536000 and "includesubdomains" in low:
        out.append(Finding(
            "Headers", "hsts-preload-candidate",
            "HSTS qualifies for browser preload list", "info", 70,
            verified=True, target=url, evidence=_redact_frag(value),
            remediation="Consider submitting to hstspreload.org.",
            cwe="", confidence=60))
    return out


def analyze_ct_header(value: str, url: str) -> List["Finding"]:
    out: List[Finding] = []
    low = value.lower()
    m = re.search(r"max-age\s*=\s*(\d+)", low)
    age = int(m.group(1)) if m else 0
    if age < 7776000:
        out.append(Finding(
            "Headers", "ct-max-age-low",
            f"Expect-CT max-age short ({age}s)", "info", 75, verified=True,
            target=url, evidence=_redact_frag(value),
            remediation="Use max-age=7776000 with enforce or per-caching.",
            cwe="CWE-693"))
    if "enforce" not in low and "per-caching" not in low:
        out.append(Finding(
            "Headers", "ct-no-mode",
            "Expect-CT present without enforce/per-caching mode", "info", 70,
            verified=True, target=url, evidence=_redact_frag(value),
            remediation="Add enforce; or rely on SCTs (TLS extension)."))
    return out


