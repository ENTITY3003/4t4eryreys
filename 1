# ─────────────────────────────────────────────────────────────────────
# robots.txt parser (RFC 9309-ish) — used to ENFORCE crawl etiquette
# ─────────────────────────────────────────────────────────────────────
def parse_robots(text: str) -> Dict[str, List[Tuple[bool, str]]]:
    """Return {user-agent: [(allow?, path), ...]} plus '_sitemaps' entries."""
    rules: Dict[str, List[Tuple[bool, str]]] = {}
    current: List[str] = []
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        m = re.match(r"(user-agent|allow|disallow|sitemap|crawl-delay|host)"
                     r"\s*:\s*(.*)", line, re.I)
        if not m:
            continue
        key, val = m.group(1).lower(), m.group(2).strip()
        if key == "user-agent":
            ua = val.lower()
            rules.setdefault(ua, [])
            current = [ua]
        elif key in ("allow", "disallow") and current:
            for ua in current:
                rules.setdefault(ua, []).append(
                    (key == "allow", val if val else "/"))
        elif key == "sitemap":
            rules.setdefault("_sitemaps", []).append((True, val))
    return rules


def robots_blocks(rules: Dict[str, List[Tuple[bool, str]]], ua: str,
                  path: str) -> bool:
    applicable = rules.get(ua, []) + rules.get("*", [])
    best_len, blocked = -1, False
    for allow, p in applicable:
        pp = p.split("$")[0]
        if not pp:
            continue
        if "*" not in pp:
            ok = path.startswith(pp.rstrip("*"))
        else:
            rx = "^" + re.escape(pp.replace("*", "%STAR%")).replace("%STAR%",
                                                                    ".*")
            rx += "$" if pp.endswith("*") else ""
            ok = bool(re.match(rx, path))
        spec = len(pp)
        if ok and spec > best_len:
            best_len, blocked = spec, (not allow)
    return blocked


# ─────────────────────────────────────────────────────────────────────
# Minimal DNS wire-format resolver (works WITHOUT dnspython installed)
# over UDP 53 to system resolvers: A/AAAA/NS/MX/TXT/SOA/CAA/TLSA/DNSKEY.
# Read-only queries; never brute-forces names.
# ─────────────────────────────────────────────────────────────────────
DNS_QTYPES = {"A": 1, "NS": 2, "CNAME": 5, "SOA": 6, "PTR": 12, "MX": 15,
              "TXT": 16, "AAAA": 28, "CAA": 257, "DNSKEY": 48, "TLSA": 52}


def _system_resolvers() -> List[str]:
    servers: List[str] = []
    try:
        for line in open("/etc/resolv.conf", encoding="utf-8",
                         errors="replace"):
            m = re.match(r"\s*nameserver\s+(\S+)", line)
            if m:
                servers.append(m.group(1))
    except OSError:
        pass
    if not servers:
        servers = ["8.8.8.8", "1.1.1.1"]
    return servers[:2]


def _dns_encode_name(name: str) -> bytes:
    out = b""
    for label in name.strip(".").split("."):
        try:
            b = (label.encode("idna") if any(ord(ch) > 127 for ch in label)
                 else label.encode("ascii"))
        except (UnicodeError, UnicodeDecodeError):
            continue
        if not 1 <= len(b) <= 63:
            continue
        out += bytes([len(b)]) + b
    return out + b"\x00"


def _dns_read_name( bytes, off: int) -> Tuple[str, int]:
    labels, jumped, new_off, steps = [], False, off, 0
    while steps < 64:
        steps += 1
        if off >= len(data):
            break
        ln = data[off]
        if ln == 0:
            off += 1
            if not jumped:
                new_off = off
            break
        if ln & 0xC0 == 0xC0:
            if off + 1 >= len(data):
                break
            ptr = ((ln & 0x3F) << 8) | data[off + 1]
            if not jumped:
                new_off = off + 2
            off = ptr
            jumped = True
            continue
        if off + 1 + ln > len(data):
            break
        labels.append(data[off + 1:off + 1 + ln].decode("ascii", "replace"))
        off += 1 + ln
        if not jumped:
            new_off = off
    return ".".join(labels) + ("." if labels else ""), new_off


def dns_query(server: str, name: str, qtype: str, timeout: float = 3.0
              ) -> Optional[List[Dict[str, Any]]]:
    qt = DNS_QTYPES.get(qtype.upper())
    if qt is None:
        return None
    tid = os.getpid() & 0xFFFF
    query = struct.pack(">HHHHHH", tid, 0x0100, 1, 0, 0, 0)
    query += _dns_encode_name(name) + struct.pack(">HH", qt, 1)
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(timeout)
        s.sendto(query, (server, 53))
        data, _ = s.recvfrom(4096)
        s.close()
    except OSError:
        return None
    if len(data) < 12:
        return None
    rid, flags, qd, an, ns, ar = struct.unpack(">HHHHHH", data[:12])
    if rid != tid or not (flags & 0x8000):
        return None
    rcode = flags & 0xF
    if rcode == 3:
        return []
    if rcode != 0:
        return None
    off = 12
    for _ in range(qd):
        _, off = _dns_read_name(data, off)
        off += 4
    answers: List[Dict[str, Any]] = []
    for _ in range(an + ns + ar):
        start = off
        try:
            rname, off = _dns_read_name(data, off)
            hdr = struct.unpack(">HHIH", data[off:off + 10])
            rtype, rclass, ttl, rdlen = hdr
            off += 10
            rdata = data[off:off + rdlen]
            off += rdlen
        except (struct.error, IndexError):
            break
        rec: Dict[str, Any] = {"name": rname, "type": rtype, "ttl": ttl}
        if rtype == 1 and len(rdata) == 4:
            rec["value"] = ".".join(str(b) for b in rdata)
        elif rtype == 28 and len(rdata) == 16:
            rec["value"] = ":".join(
                f"{rdata[i]:02x}{rdata[i + 1]:02x}" for i in range(0, 16, 2))
        elif rtype in (2, 5, 12):
            nm, _ = _dns_read_name(data, start)
            rec["value"] = nm
        elif rtype == 15 and len(rdata) > 2:
            pref = struct.unpack(">H", rdata[:2])[0]
            nm, _ = _dns_read_name(data, start + 10)
            rec["value"] = f"{pref} {nm}"
        elif rtype == 16:
            parts, p = [], 0
            while p < len(rdata):
                ln = rdata[p]
                parts.append(rdata[p + 1:p + 1 + ln].decode("utf-8", "replace"))
                p += 1 + ln
            rec["value"] = " ".join(parts)
        elif rtype == 6:
            mname, o2 = _dns_read_name(data, start + 10)
            rname2, o3 = _dns_read_name(data, o2)
            try:
                serial, refresh, retry, expire, minttl = struct.unpack(
                    ">IIIII", data[o3:o3 + 20])
                rec["value"] = (f"{mname} {rname2} serial={serial} "
                                f"refresh={refresh} retry={retry} "
                                f"expire={expire} negative_ttl={minttl}")
            except struct.error:
                rec["value"] = mname
        elif rtype == 257 and len(rdata) >= 2:
            taglen = rdata[1]
            tag = rdata[2:2 + taglen].decode("ascii", "replace")
            val = rdata[2 + taglen:].decode("ascii", "replace")
            rec["value"] = f"{rdata[0]} {tag} \"{val}\""
        else:
            rec["value"] = rdata.hex()
        answers.append(rec)
    return answers


def dns_query_all(name: str, qtype: str) -> List[Dict[str, Any]]:
    for srv in _system_resolvers():
        res = dns_query(srv, name, qtype)
        if res:
            return res
    return []


# ─────────────────────────────────────────────────────────────────────
# Extended TLS probing: protocol matrix + bounded handshake probes.
# One handshake per family representative only — never a cipher sweep.
# ─────────────────────────────────────────────────────────────────────
WEAK_SUITES = [
    ("NULL", "anonymous/NULL encryption"),
    ("EXPORT", "export-grade crypto"),
    ("RC4", "stream cipher with biases"),
    ("DES", "56-bit legacy block cipher"),
    ("3DES", "SWEET32 birthday attacks"),
    ("MD5", "broken MAC algorithm"),
]

STRONG_NOTE = "TLS1.3 AEAD suites preferred (ChaCha20-Poly1305 / AES-GCM)."


def tls_handshake_probe(host: str, port: int, *, sni: bool = True,
                        max_version=None, timeout: float = 4.0
                        ) -> Optional[Dict[str, Any]]:
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    try:
        if max_version is not None:
            ctx.maximum_version = max_version
        with socket.create_connection((host, port), timeout=timeout) as sock:
            with ctx.wrap_socket(sock,
                                 server_hostname=(host if sni else None)) as ts:
                ct = ts.cipher() or ("", "", "")
                return {"version": ts.version, "cipher": ct[0],
                        "bits": (ct[2] if len(ct) > 2 else 0)}
    except Exception:
        return None


def enumerate_tls_families(host: str, port: int, throttle_wait=None
                          ) -> Dict[str, str]:
    """Bounded matrix: TLS1.3 / TLS1.2 / TLS1.1 / TLS1.0 / no-SNI.
    Exactly ONE handshake per row — informational, never exhaustive."""
    results: Dict[str, str] = {}
    rows = [
        ("TLS1.3", dict(max_version=ssl.TLSVersion.TLSv1_3)),
        ("TLS1.2", dict(max_version=ssl.TLSVersion.TLSv1_2)),
    ]
    for old_attr in ("TLSv1_1", "TLSv1"):
        mv = getattr(ssl.TLSVersion, old_attr, None)
        if mv is not None:
            rows.append((old_attr.replace("TLSv", "TLS ").replace("_", "."),
                         dict(max_version=mv)))
    rows.append(("NO-SNI", dict(sni=False)))
    for label, kw in rows:
        if throttle_wait:
            throttle_wait()
        r = tls_handshake_probe(host, port, **kw)
        results[label] = (f"{r['version']} {r['cipher']}"
                          if r else "unavailable")
    return results


