def load_embedded_wordlist(text: str, limit: int = 400) -> List[str]:
    items: List[str] = []
    seen = set()
    for line in text.splitlines():
        p = line.strip()
        if not p or p.startswith("#"):
            continue
        if not p.startswith("/"):
            p = "/" + p
        low = p.lower()
        # SAFETY GUARD: never allow traversal/system/exploit entries
        if ".." in p or any(x in low for x in
                            ("/etc/", "win.ini", "id_rsa", "authorized_keys",
                             "shell.php", ".php?", "/proc/", "webshell",
                             "passwd", "shadow")):
            continue
        if p in seen:
            continue
        seen.add(p)
        items.append(p)
        if len(items) >= limit:
            break
    return items


