def http_get_text(url: str, timeout: float = 8.0,
                  headers: Optional[Dict[str, str]] = None,
                  throttle: Optional[Throttle] = None) -> Optional[str]:
    """Module-level GET helper that optionally shares the scanner throttle."""
    if throttle is not None:
        throttle.wait()
    try:
        s = requests.Session()
        s.headers.update({"User-Agent": UA})
        if headers:
            s.headers.update(headers)
        r = s.get(url, timeout=timeout)
        if r.status_code == 200:
            return r.text
        return None
    except Exception:
        return None


def github_raw_read(repo: str, branch: str, path: str,
                    throttle: Optional[Throttle] = None) -> Optional[str]:
    """Read one text file from a public GitHub repo through the mirror
    chain (raw.githubusercontent → scorpian.ir gh mirror → fallbacks).
    Returns None if every mirror failed."""
    clean_path = path.lstrip("/")
    tried: List[str] = []
    for base in GITHUB_MIRROR_HOSTS:
        url = f"{base}/{repo}/{branch}/{clean_path}"
        tried.append(url)
        txt = http_get_text(url, timeout=10.0, throttle=throttle)
        if txt is not None:
            return txt
    return None


def github_tree_entries(repo: str, branch: str, subpath: str,
                        throttle: Optional[Throttle] = None
                        ) -> List[Dict[str, Any]]:
    """List a directory inside a public GitHub repo using the GitHub REST
    tree API (unauthenticated, low rate). Returns [] on failure."""
    api = (f"https://api.github.com/repos/{repo}/contents/"
           f"{subpath.strip('/')}?ref={branch}")
    txt = http_get_text(api, timeout=10.0, throttle=throttle,
                        headers={"Accept": "application/vnd.github+json"})
    if not txt:
        return []
    try:
        data = json.loads(txt)
        if isinstance(data, list):
            return data
    except Exception:
        pass
    return []


def checkhost_start(check_type: str, target: str,
                    nodes: Optional[List[str]] = None,
                    throttle: Optional[Throttle] = None
                    ) -> Optional[Dict[str, Any]]:
    """Start a check-host.net observation job (ping/http/dns/tcp/smtp).
    Public API pattern: POST https://check-host.net/check-{type}
    form fields host=<target>&nodes[]=<node>. Returns {'request_id':...}.
    NOTE: this queries check-host's OWN distributed probe nodes — our
    machine never touches the target here; check-host does, from datacentre
    IPs around the world. That is exactly the 'view from outside' feature."""
    node_list = nodes or CHECKHOST_NODES[:6]
    payload = {"host": target}
    for n in node_list:
        payload.setdefault("nodes[]", [])
        if isinstance(payload["nodes[]"], list):
            payload["nodes[]"].append(n)
    url = f"https://check-host.net/check-{check_type}"
    if throttle is not None:
        throttle.wait()
    try:
        s = requests.Session()
        s.headers.update({"User-Agent": UA, "Accept": "application/json"})
        r = s.post(url, data=payload, timeout=15.0)
        if r.status_code != 200:
            return None
        js = r.json()
        if js.get("ok") == 1 and js.get("request_id"):
            js["permanent_link"] = (
                "https://check-host.net/check-report/" + js["request_id"])
            return js
    except Exception:
        return None
    return None


def checkhost_poll(request_id: str, wait_secs: int = 6,
                   throttle: Optional[Throttle] = None
                   ) -> Optional[Dict[str, Any]]:
    """Poll check-host result endpoint until results appear or timeout."""
    deadline = time.time() + wait_secs
    last: Optional[Dict[str, Any]] = None
    while time.time() < deadline:
        if throttle is not None:
            throttle.wait()
        try:
            s = requests.Session()
            s.headers.update({"User-Agent": UA,
                              "Accept": "application/json"})
            r = s.get(f"https://check-host.net/check-result/{request_id}",
                      timeout=10.0)
            if r.status_code == 200:
                last = r.json()
                if any(v is not None for v in (last or {}).values()):
                    return last
        except Exception:
            pass
        time.sleep(1.5)
    return last


def ip_geo_info(ip: str, throttle: Optional[Throttle] = None
                ) -> Dict[str, Any]:
    """Best-effort IP metadata via public JSON APIs (ip-api.com first,
    then ipinfo.io). Never raises."""
    out: Dict[str, Any] = {}
    txt = http_get_text(f"http://ip-api.com/json/{ip}?fields=status,country,"
                        f"regionName,city,lat,lon,isp,org,as,reverse",
                        timeout=8.0, throttle=throttle)
    if txt:
        try:
            d = json.loads(txt)
            if d.get("status") == "success":
                out.update({
                    "country": d.get("country"), "region": d.get("regionName"),
                    "city": d.get("city"), "isp": d.get("isp"),
                    "org": d.get("org"), "asn": d.get("as"),
                    "reverse": d.get("reverse"),
                })
                return out
        except Exception:
            pass
    txt = http_get_text(f"https://ipinfo.io/{ip}/json", timeout=8.0,
                        throttle=throttle)
    if txt:
        try:
            d = json.loads(txt)
            out.update({"country": d.get("country"), "city": d.get("city"),
                        "org": d.get("org"), "asn": d.get("org"),
                        "isp": d.get("org")})
        except Exception:
            pass
    return out


