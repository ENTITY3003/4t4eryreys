# SELF-TEST SUITE — spins a vulnerable-by-design localhost server and
# proves every module + safety rule.  sudo python3 h303_scanner.py --selftest
# Nothing here touches any network except 127.0.0.1.
# ─────────────────────────────────────────────────────────────────────
def _start_test_server():
    import http.server
    import socketserver

    PAGE = b"""<html><head><title>Test</title>
<meta name="generator" content="WordPress 6.4.2"></head>
<body>
<img src="http://cdn.example.org/x.png">hello /wp-content/themes/x/style.css
<script src="/app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
<form action="http://login.example.org/in"></form>
<script>var apiKey = "sk_live_A1B2C3D4E5F6G7H8I9J0";
document.write("<b>x</b>"); eval("1+1"); postMessage(d, "*"); debugger;</script>
<div class="wp-includes">x</div>
</body></html>"""

    APPJS = (b"const secretKey=\"supersecretvalueABCDEFGHIJKLMNOP\";\n"
             b"var t='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9."
             b"eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U';\n"
             b"new Function('return 1')();\nsetTimeout(\"alert(1)\", 100);\n"
             b"console.log('token', t);\n//# sourceMappingURL=/app.js.map\n")

    MAPJSON = json.dumps({"version": 3, "sources": ["src/auth.js", "src/app.js"],
                          "sourcesContent": ["// original private source",
                                             "// more hidden code"],
                          "names": [], "mappings": "AAAA"}).encode()

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body=b"", ct="text/html", extra=None):
            self.send_response(code)
            self.send_header("Content-Type", ct)
            self.send_header("Server", "Apache/2.4.52 (Ubuntu)")
            self.send_header("Set-Cookie", "sess=abc123; Path=/; SameSite=Lax")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            if body:
                self.wfile.write(body)

        def do_GET(self):
            p = self.path
            if p == "/.git/HEAD":
                self._send(200, b"ref: refs/heads/main", "text/plain")
            elif p == "/xmlrpc.php":
                self._send(200, b"XML-RPC works here", "text/xml")
            elif p == "/robots.txt":
                self._send(200, b"User-agent: *\nDisallow: /admin-backup/\n"
                                b"Disallow: /public-docs/\n", "text/plain")
            elif p == "/app.js":
                self._send(200, APPJS, "application/javascript")
            elif p == "/app.js.map":
                self._send(200, MAPJSON, "application/json")
            elif p == "/readme.html":
                self._send(200, b"<h1>WordPress > Version 6.4.2</h1>")
            elif p == "/sitemap.xml":
                self._send(200, b"<urlset><url><loc>/about</loc></url></urlset>",
                           "application/xml")
            elif p.startswith("/admin"):
                self._send(404, b"nope")
            else:
                self._send(200, PAGE)

        def do_OPTIONS(self):
            self._send(204, b"", extra={"Access-Control-Allow-Origin": "*",
                                        "Access-Control-Allow-Credentials": "true"})

    srv = socketserver.ThreadingTCPServer(("127.0.0.1", 0), H)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv, srv.server_address[1]


def run_selftest() -> int:
    print(f"{VERSION} — SELF-TEST (localhost only, nothing external touched)")
    checks: List[Tuple[str, bool]] = []

    def ck(name: str, cond: bool):
        checks.append((name, bool(cond)))
        print(f"  [{'PASS' if cond else 'FAIL'}] {name}")

    # ---- unit: wordlist sanitizer blocks traversal/system junk ----
    dirty = "/ok\n/../etc/passwd\n/etc/shadow\nshell.php\n/id_rsa\n/env\n/.git/HEAD\n"
    clean = load_embedded_wordlist(dirty, 100)
    ck("wordlist sanitizer removes traversal/system entries",
       all(".." not in p and "/etc/" not in p and "passwd" not in p
           and "shadow" not in p and "id_rsa" not in p for p in clean)
       and "/ok" in clean and "/.git/HEAD" in clean)

    # ---- unit: throttle hard cap ----
    th = Throttle(500)
    ck("throttle enforces HARD CAP of 20 rps", th.rate == 20.0)

    # ---- unit: workers hard cap ----
    sc0 = DentistScanner("http://127.0.0.1:1", workers=99)
    ck("worker pool capped at 8 threads", sc0.workers == 8)

    # ---- unit: JS analyzer finds planted issues ----
    js = ("var apiKey = \"sk_live_ABCDEFGHIJKLMNOP\"; document.write('x');"
          "eval('1'); new Function('return 1')();"
          "window.postMessage(x, '*');"
          "setTimeout(\"f()\", 1); console.log('token', t);"
          "//# sourceMappingURL=/a.js.map")
    ids = [h[0] for h in analyze_js_source(js, "unit")]
    for want in ("js-hardcoded-key", "js-document-write", "js-eval",
                 "js-function-constructor", "js-postmessage-star",
                 "js-setinterval-timeout-str", "js-console-log",
                 "js-sourcemap-ref"):
        ck(f"JS analyzer detects {want}", want in ids)
    ck("JS analyzer masks secret VALUES in evidence",
       all("ABCDEFGHIJKLMNOP" not in h[3] for h in analyze_js_source(js, "unit")))

    # ---- unit: PDF writer produces valid file ----
    fd = [Finding("Headers", "t", "Title <&>", "high", 90, verified=True,
                  evidence="x" * 300, remediation="fix", cwe="CWE-1").to_dict()]
    p = os.path.join(os.getcwd(), "selftest_report.pdf")
    build_pdf(fd, {"target": "t", "generated": "now", "duration": 1.2,
                   "requests": 3}, ["line1", "line2"], p)
    head = open(p, "rb").read(8)
    tail = open(p, "rb").read()[-10:]
    ck("PDF magic header %PDF", head.startswith(b"%PDF"))
    ck("PDF trailer %%EOF", tail.rstrip().endswith(b"%%EOF"))
    ck("PDF non-trivial size", os.path.getsize(p) > 1500)
    os.remove(p)

    # ---- integration: full scan against the mock vulnerable server ----
    srv, port = _start_test_server()
    time.sleep(0.3)
    logs: List[str] = []
    emitted: List[Finding] = []
    prog = [0.0]
    sc = DentistScanner(f"http://127.0.0.1:{port}",
                        log=lambda m: logs.append(m),
                        emit=lambda f: emitted.append(f),
                        progress=lambda x: prog.__setitem__(0, x),
                        rps=15, workers=4, verify=True)
    fs = sc.run()
    srv.shutdown()
    names = [f.name for f in fs]
    cats = {f.category for f in fs}
    ev_all = " ".join((f.evidence or "") + (f.description or "") for f in fs)

    ck("module DNS ran", "DNS" in cats)
    ck("module Headers: missing-hsts found", "missing-hsts" in names)
    ck("module Headers: missing-csp found", "missing-csp" in names)
    ck("module Headers: server-version found", "server-version" in names)
    ck("module Cookies: cookie attribute finding", any(n.startswith("cookie-") for n in names))
    ck("module CORS: wildcard+credentials caught", "cors-star-creds" in names)
    ck("module Exposure: git HEAD exposure", any(n.startswith("exposed--git-HEAD") for n in names))
    ck("module Exposure: xmlrpc detected", any("xmlrpc" in n for n in names))
    ck("module Recon: robots found", "robots-found" in names)
    ck("module Recon: sensitive robots entry", "robots-sensitive-entry" in names)
    ck("module Recon: sitemap found", "sitemap-found" in names)
    ck("module CMS: wordpress fingerprint", "wordpress" in names)
    ck("module CMS: generator meta captured", "generator" in names)
    ck("module JS-Review: hardcoded key (inline)",
       any(f.name == "js-hardcoded-key" and "inline" in (f.evidence or "") for f in fs))
    ck("module JS-Review: external app.js reviewed (JWT)",
       any(f.name == "js-jwt" for f in fs))
    ck("module JS-Review: sourcemap leak detected", "sourcemap-public" in names)
    ck("module JS-Review: sourcemap shows sourcesContent",
       any(f.name == "sourcemap-public" and "PRESENT" in (f.evidence or "") for f in fs))
    ck("module JS-Review: form http action", "form-http-action" in names)
    ck("module JS-Review: CDN without SRI", "cdn-no-sri" in names)
    ck("module Transport: cleartext HTTP flagged (no-https)",
       any(f.category == "Transport" and f.name in ("mixed-content", "no-https")
           for f in fs))
    ck("module TLS ran on https target",
       all(f.name != "cert-expired" for f in fs))  # mock server is http-only
    ck("progress callback reached 100%", prog[0] >= 1.0)
    ck("findings emitted live via callback", len(emitted) == len(fs))
    ck("verification marked reproduced findings", sum(1 for f in fs if f.verified) >= 5)

    # ---- safety assertions ----
    crawled_forbidden = any("/admin-backup" in (f.evidence or "")
                            and f.category == "Exposure" for f in fs)
    ck("SAFETY: robots Disallow paths were NOT crawled", not crawled_forbidden)
    ck("SAFETY: no traversal probes anywhere", ".." not in ev_all)
    ck("SAFETY: no system-file probes", "/etc/passwd" not in ev_all
       and "win.ini" not in ev_all.lower())
    ck("SAFETY: secret values never recorded in evidence",
       "sk_live_ABCDEFGHIJKLMNOP" not in ev_all
       and "supersecretvalue" not in ev_all)
    ck("SAFETY: offsite redirects skipped counter exists",
       "skipped" in sc.stats)
    ck("SAFETY: request count bounded & logged", sc.stats["requests"] > 0)

    # ---- report export from scan results ----
    outp = os.path.join(os.getcwd(), "selftest_full.pdf")
    meta = {"target": sc.target, "generated": time.strftime("%F %T"),
            "duration": sc.duration, "requests": sc.stats["requests"]}
    build_pdf([f.to_dict() for f in fs], meta, logs, outp)
    sz = os.path.getsize(outp)
    ck(f"full PDF report written ({sz}B)", sz > 3000)
    jp = outp.replace(".pdf", ".json")
    with open(jp, "w", encoding="utf-8") as fh:
        json.dump({"meta": meta, "findings": [f.to_dict() for f in fs]}, fh,
                  ensure_ascii=False, indent=2)
    ck("JSON report written", os.path.getsize(jp) > 500)
    os.remove(outp)
    os.remove(jp)

    failed = [n for n, okk in checks if not okk]
    print(f"\n════ SELF-TEST RESULT: {len(checks) - len(failed)}/"
          f"{len(checks)} passed ════")
    if failed:
        print("FAILED:", *failed, sep="\n  - ")
        return 1
    print("ALL CHECKS PASSED — engine is healthy, safety rails intact.")
    return 0


