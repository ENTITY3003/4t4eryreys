def normalize_url(base: str, href: str) -> Optional[str]:
    try:
        u = urljoin(base, href.strip())
    except ValueError:
        return None
    p = urlparse(u)
    if p.scheme not in ("http", "https"):
        return None
    return urlunparse((p.scheme, p.netloc, p.path or "/", "", p.query, ""))

# The scanner — 10 modules, all read-only
# ─────────────────────────────────────────────────────────────────────
class DentistScanner:
    MAX_BODY_SCAN = 200_000          # bytes we look at (never saved)
    MAX_WORKERS_CAP = 8              # hard cap on concurrency
    MAX_JS_FILES = 12                # external scripts reviewed per scan
    MAX_POST_REQUESTS = 40           # HARD cap on form POSTs per whole scan

    def __init__(self, target: str, log: Callable[[str], None] = None,
                 emit: Callable[["Finding"], None] = None,
                 progress: Callable[[float], None] = None,
                 rps: float = 2.0, workers: int = 4,
                 verify: bool = True, deep_portscan: bool = False,
                 mode: str = "standard", full_sweep: bool = False,
                 udp_scan: bool = False, all_tcp_ports: bool = False,
                 auth_user: str = "", auth_pass: str = ""):
        raw = target.strip()
        if raw and not raw.startswith(("http://", "https://")):
            raw = "https://" + raw
        self.target = raw.rstrip("/")
        self.parsed = urlparse(self.target)
        self.host = self.parsed.hostname or ""
        self.log = log or (lambda m: None)
        self.emit = emit or (lambda f: None)
        self.progress = progress or (lambda p: None)
        self.throttle = Throttle(rps)
        self.workers = max(1, min(int(workers), self.MAX_WORKERS_CAP))
        self.verify_enabled = verify
        self.deep_portscan = deep_portscan
        self.mode = mode if mode in ("quick", "standard", "deep") else "standard"
        self.full_sweep = bool(full_sweep)
        self.udp_scan = bool(udp_scan)
        self.all_tcp_ports = bool(all_tcp_ports)
        self.auth_user = auth_user or ""
        self.auth_pass = auth_pass or ""
        self.findings: List[Finding] = []
        self.session = self._mk_session()
        self._cancel = threading.Event()
        self.stats = {"requests": 0, "skipped": 0, "denied": 0,
                      "budget_stops": 0, "post_requests": 0,
                      "method_requests": 0}
        self.duration = 0.0
        # crawl state (bounded, same-origin only, robots-respecting)
        self.MAX_REQUESTS = 4000           # HARD budget cap per scan
        self.MAX_CRAWL_PAGES = 60          # HARD page cap per scan
        self._visited: set = set()
        self._visit_lock = threading.Lock()
        self._seen_names: set = set()
        self._discovered_urls: List[str] = []
        self._robots_rules: Dict[str, List[Tuple[bool, str]]] = {}
        self._html_cache: Optional[str] = None
        self._final_url: Optional[str] = None
        self._root_response = None
        # ── v4 accumulators ────────────────────────────────────────────
        self.cdn_info: Dict[str, Any] = {}
        self.origin_ip: Optional[str] = None
        self.waf_name: Optional[str] = None
        self.js_html_map: Dict[str, str] = {}      # js url -> html page url
        self.login_forms: List[Dict[str, Any]] = []
        self._form_sig_seen: set = set()
        self._baseline_body_rx: Optional[re.Pattern] = None
        self._baseline_len = 0
        self._bfs_queue: List[str] = []
        self.checklist_status: Dict[str, str] = {}
        self._ck_done: set = set()

    # ---------- helpers ----------
    def _mk_session(self):
        s = requests.Session()
        s.headers.update({"User-Agent": UA, "Accept": "*/*"})
        s.max_redirects = 5
        return s

    def cancelled(self) -> bool:
        return self._cancel.is_set()

    def stop(self):
        self._cancel.set()

    def get(self, url: str, timeout: float = 10.0,
            headers: Optional[Dict[str, str]] = None,
            follow_offsite: bool = False,
            **kw) -> Optional["requests.Response"]:
        """Throttled GET-only fetch. Budget-capped; offsite results dropped
        unless the caller explicitly opts into following offsite hops."""
        if self.cancelled() or not HAVE_REQUESTS:
            return None
        if self.stats["requests"] >= self.MAX_REQUESTS:
            self.stats["budget_stops"] += 1
            return None
        self.throttle.wait()
        try:
            r = self.session.get(url, timeout=timeout, allow_redirects=True,
                                 headers=headers, **kw)
            self.stats["requests"] += 1
            fin_host = urlparse(r.url).hostname or ""
            if fin_host != self.host and not follow_offsite:
                self.stats["skipped"] += 1
                return None
            return r
        except requests.RequestException:
            return None

    # ---------- v4: bounded request helpers (still capped & throttled) --
    def _budget_ok(self) -> bool:
        if self.cancelled() or not HAVE_REQUESTS:
            return False
        if self.stats["requests"] >= self.MAX_REQUESTS:
            self.stats["budget_stops"] += 1
            return False
        return True

    def head(self, url: str, timeout: float = 8.0,
             headers: Optional[Dict[str, str]] = None
             ) -> Optional["requests.Response"]:
        """HEAD probe — zero body transferred."""
        if not self._budget_ok():
            return None
        self.throttle.wait()
        try:
            r = self.session.head(url, timeout=timeout, headers=headers,
                                  allow_redirects=False)
            self.stats["requests"] += 1
            return r
        except requests.RequestException:
            return None

    def options(self, url: str, timeout: float = 8.0,
                headers: Optional[Dict[str, str]] = None
                ) -> Optional["requests.Response"]:
        """OPTIONS observation (CORS preflight / Allow header reading)."""
        if not self._budget_ok():
            return None
        self.throttle.wait()
        try:
            r = self.session.options(url, timeout=timeout, headers=headers,
                                     allow_redirects=False)
            self.stats["requests"] += 1
            return r
        except requests.RequestException:
            return None

    def http_request(self, method: str, url: str, *, timeout: float = 10.0,
                     headers: Optional[Dict[str, str]] = None,
                     params: Optional[Dict[str, Any]] = None,
                      Any = None, json_body: Any = None,
                     allow_redirects: bool = False,
                     budget_key: str = "method_requests",
                     auth: Any = None) -> Optional["requests.Response"]:
        """Generic bounded HTTP verb used by the METHODOLOGY module only.
        Every call still passes through the global token-bucket throttle
        and the hard per-scan request budget."""
        if not self._budget_ok():
            return None
        self.throttle.wait()
        try:
            r = self.session.request(method.upper(), url, timeout=timeout,
                                     headers=headers, params=params,
                                     data=data, json=json_body,
                                     allow_redirects=allow_redirects, auth=auth)
            self.stats["requests"] += 1
            self.stats[budget_key] = self.stats.get(budget_key, 0) + 1
            return r
        except requests.RequestException:
            return None

    def post_form(self, url: str, form_ Dict[str, str], *,
                  timeout: float = 12.0, headers: Optional[Dict] = None,
                  cookies: Optional[Dict[str, str]] = None,
                  allow_redirects: bool = True
                  ) -> Optional["requests.Response"]:
        """Bounded POST of a FORM exactly as a browser would submit it.
        Used ONLY for authorized-login checks (operator-supplied creds) and
        baseline-vs-marker form behaviour comparison. Hard-capped at
        MAX_POST_REQUESTS for the whole scan; never used to flood."""
        if not self._budget_ok():
            return None
        if self.stats.get("post_requests", 0) >= self.MAX_POST_REQUESTS:
            self.stats["budget_stops"] += 1
            return None
        self.throttle.wait()
        try:
            s = requests.Session()
            s.headers.update({"User-Agent": UA})
            r = s.post(url, data=form_data, timeout=timeout, headers=headers,
                       cookies=cookies, allow_redirects=allow_redirects)
            self.stats["requests"] += 1
            self.stats["post_requests"] += 1
            return r
        except requests.RequestException:
            return None

    def add(self, f: Finding):
        if f.confidence < 30:
            return
        f.target = self.target
        key = (f.category, f.name, f.evidence[:80])
        with self._visit_lock:
            if key in self._seen_names:
                return
            self._seen_names.add(key)
        self.findings.append(f)
        self.emit(f)
        self.log(f"[{f.severity.upper()}] {f.title}")

    # ---------- verification (false-positive killer) ----------
    def _refetch(self, url: str):
        if self.cancelled() or not HAVE_REQUESTS:
            return None
        self.throttle.wait()
        try:
            s = requests.Session()
            s.headers.update({"User-Agent": UA})
            r = s.get(url, timeout=10, allow_redirects=False)
            self.stats["requests"] += 1
            return r
        except requests.RequestException:
            return None

    def verify_finding(self, f: Finding, url: str,
                       check: Callable[..., bool]) -> bool:
        """Re-request with an independent session; only reproduced findings
        keep verified=True. Unverified ones lose half their confidence."""
        if not self.verify_enabled:
            f.verified = True
            return True
        ok = False
        for attempt in range(2):
            r = self._refetch(url)
            if r is not None and check(r):
                ok = True
                break
            if attempt == 0:
                time.sleep(1.0)
        f.verified = ok
        if not ok:
            f.confidence = max(10, f.confidence // 2)
            f.evidence += " | UNVERIFIED (could not reproduce)"
        return ok

    def _root_html(self):
        """Fetch '/' once (cache body AND headers) for later modules."""
        if self._html_cache is None:
            r = self.get(self.target + "/")
            if r is None:
                return None, None
            self._html_cache = r.text[:400_000]
            self._final_url = r.url
            self._root_response = r
        return self._html_cache, self._final_url

    # ============================================================
    # MODULE 1 — DNS & email-security recon (read-only)
    # ============================================================
    def mod_dns(self):
        self.log("— [1/10] DNS recon")
        try:
            infos = socket.getaddrinfo(self.host, None)
            ips = sorted({i[4][0] for i in infos})
        except socket.gaierror:
            self.add(Finding("DNS", "no-resolution", "Domain does not resolve",
                             "info", 95, evidence="NXDOMAIN / no A record"))
            return
        self.add(Finding("DNS", "resolved", "DNS resolution", "info", 100,
                         verified=True,
                         description=f"{self.host} resolves to {', '.join(ips)}",
                         evidence=", ".join(ips)))
        if len(ips) > 1:
            self.add(Finding("DNS", "multi-ip", "Multiple A records (LB/CDN)",
                             "info", 90, verified=True, evidence=", ".join(ips)))
        try:
            alias = socket.gethostbyname_ex(self.host)[1]
            if alias:
                self.add(Finding("DNS", "cname", "CNAME record present", "info", 90,
                                 evidence=", ".join(alias),
                                 description="Target is fronted by another hostname "
                                             "(possible CDN/proxy)."))
        except Exception:
            pass
        txt = self._lookup_txt()
        if txt:
            self.add(Finding("DNS", "txt", "DNS TXT records", "info", 85,
                             evidence="; ".join(txt)[:500]))
        spf = [t for t in txt if t.lower().startswith("v=spf1")]
        if txt and not spf:
            self.add(Finding("Email-Security", "no-spf", "SPF record missing",
                             "medium", 80, verified=True,
                             description="No v=spf1 TXT record found; domain can be "
                                         "spoofed in email.",
                             remediation="Publish an SPF record.", cwe="CWE-290"))
        elif spf and "+all" in spf[0].lower():
            self.add(Finding("Email-Security", "spf-plus-all",
                             "SPF ends with +all (permits any sender)", "high", 95,
                             verified=True, evidence=spf[0][:200],
                             remediation="Replace +all with -all.", cwe="CWE-290"))
        if not self._has_dmarc():
            self.add(Finding("Email-Security", "no-dmarc", "DMARC record missing",
                             "medium", 80, verified=True,
                             remediation="Add _dmarc.<domain> TXT record with "
                                         "p=quarantine/reject.", cwe="CWE-290"))

    def _lookup_txt(self) -> List[str]:
        try:
            import dns.resolver  # optional dependency
            return [str(r).strip('"') for r in dns.resolver.resolve(self.host, "TXT")]
        except Exception:
            return []

    def _has_dmarc(self) -> bool:
        base = ".".join(self.host.split(".")[-2:]) if self.host.count(".") >= 1 else self.host
        try:
            import dns.resolver
            dns.resolver.resolve(f"_dmarc.{base}", "TXT")
            return True
        except Exception:
            return False

    # ============================================================
    # MODULE 2 — TCP port reachability (single connect each, safe)
    # ============================================================
    TOP_PORTS = [21, 22, 23, 25, 53, 80, 110, 143, 443, 445, 465, 587, 993, 995,
                 1433, 1521, 2049, 2375, 3000, 3306, 3389, 5432, 5601, 5900,
                 6379, 8000, 8080, 8443, 8888, 9000, 9092, 9200, 11211, 27017]

    def mod_ports(self):
        ports = list(self.TOP_PORTS)
        if self.deep_portscan:
            ports = sorted(set(ports + list(range(1, 1025))))
        if self.all_tcp_ports:
            ports = sorted(set(ports + list(range(1, 65536))))
        elif self.full_sweep:
            ports = sorted(set(ports + list(range(1, 1025)) +
                               list(range(1024, 9099))))
        self.log(f"— [2/10] TCP connect scan ({len(ports)} ports, "
                 f"{self.workers} workers)")
        open_ports: List[int] = []
        with cf.ThreadPoolExecutor(max_workers=self.workers) as ex:
            futs = {ex.submit(self._tcp_probe, p): p for p in ports}
            for fut in cf.as_completed(futs):
                if self.cancelled():
                    break
                p, state = fut.result()
                if state == "open":
                    open_ports.append(p)
        open_ports.sort()
        risky = {21: "FTP cleartext", 23: "Telnet", 25: "SMTP", 110: "POP3",
                 143: "IMAP", 445: "SMB", 1433: "MSSQL", 1521: "Oracle",
                 2375: "Docker API (unauthenticated!)", 3306: "MySQL",
                 3389: "RDP", 5432: "PostgreSQL", 5601: "Kibana", 5900: "VNC",
                 6379: "Redis", 9200: "Elasticsearch", 11211: "Memcached",
                 27017: "MongoDB", 9092: "Kafka"}
        for p in open_ports:
            sev = "high" if p in risky and p not in (80, 443) else "info"
            self.add(Finding("Network", f"port-{p}-open",
                             f"TCP port {p} open" + (f" — {risky[p]}" if p in risky else ""),
                             sev, 90, verified=True,
                             evidence=f"{self.host}:{p} accepted connection",
                             remediation="Restrict exposure via firewall unless required."
                                         if sev == "high" else "",
                             cwe="CWE-284" if sev == "high" else ""))

    def _tcp_probe(self, port: int) -> Tuple[int, str]:
        if self.cancelled():
            return port, "closed"
        try:
            with socket.create_connection((self.host, port), timeout=2.0):
                return port, "open"
        except (socket.timeout, ConnectionRefusedError, OSError):
            return port, "closed"

    # ============================================================
    # MODULE 3 — TLS / certificate analysis
    # ============================================================
    def mod_tls(self):
        port = self.parsed.port or 443
        self.log("— [3/10] TLS analysis")
        ctx = ssl.create_default_context()
        peercert: Dict = {}
        proto = cipher = ""
        try:
            with socket.create_connection((self.host, port), timeout=10) as sock:
                with ctx.wrap_socket(sock, server_hostname=self.host) as ts:
                    proto = ts.version
                    ct = ts.cipher() or ("", "", "")
                    cipher = f"{ct[0]} ({ct[1]}, {ct[2]})"
                    peercert = ts.getpeercert()
        except ssl.SSLCertVerificationError as e:
            self.add(Finding("TLS", "cert-invalid", "Certificate validation FAILED",
                             "high", 95, verified=True, evidence=str(e)[:300],
                             remediation="Install a trusted CA-signed cert; fix chain.",
                             cwe="CWE-295"))
            return
        except OSError:
            return
        if not peercert:
            return
        try:
            nb = ssl.cert_time_to_seconds(peercert["notAfter"])
            days = (nb - time.time()) / 86400
            if days < 0:
                self.add(Finding("TLS", "cert-expired", "Certificate EXPIRED",
                                 "critical", 100, verified=True,
                                 evidence=peercert["notAfter"],
                                 remediation="Renew immediately.", cwe="CWE-298"))
            elif days < 21:
                self.add(Finding("TLS", "cert-expiring",
                                 f"Certificate expires in {int(days)} days",
                                 "medium", 100, verified=True,
                                 evidence=peercert["notAfter"],
                                 remediation="Enable auto-renewal."))
            else:
                self.add(Finding("TLS", "cert-valid-until", "Certificate validity",
                                 "info", 100, verified=True,
                                 evidence=f"{peercert['notAfter']} ({int(days)} days)"))
        except Exception:
            pass
        subj = dict(x[0] for x in peercert.get("subject", ()))
        cn = subj.get("commonName", "")
        sans = [v for k, v in peercert.get("subjectAltName", ()) if k == "DNS"]
        if cn and not sans:
            self.add(Finding("TLS", "no-san", "Certificate lacks SubjectAltName",
                             "low", 85, evidence=f"CN={cn}",
                             remediation="Issue cert with SAN entries.", cwe="CWE-297"))
        weak = re.search(r"RC4|DES|MD5|NULL|EXPORT", cipher or "", re.I)
        if weak:
            self.add(Finding("TLS", "weak-cipher", "Weak negotiated cipher",
                             "high", 90, verified=True, evidence=cipher,
                             remediation="Restrict to TLS1.2+ AEAD suites.",
                             cwe="CWE-327"))
        if proto in ("TLSv1", "SSLv3", "TLSv1.1"):
            self.add(Finding("TLS", "old-protocol", f"Obsolete protocol: {proto}",
                             "high", 95, verified=True, evidence=proto,
                             remediation="Disable TLS<1.2.", cwe="CWE-326"))
        else:
            self.add(Finding("TLS", "protocol", "Negotiated TLS version", "info",
                             100, verified=True, evidence=f"{proto} | {cipher}"))
        try:
            exts = peercert.get("extensions", ())
            names = {e[0] for e in exts}
            if "OCSP URLs" not in names and "CA Issuers" not in names:
                self.add(Finding("TLS", "no-ocsp-info", "No OCSP info in certificate",
                                 "info", 60,
                                 description="Cannot confirm revocation infra from "
                                             "the leaf cert alone.",
                                 remediation="Publish OCSP/CRL endpoints; enable stapling."))
        except Exception:
            pass

    # ============================================================
    # MODULE 4 — HTTP response headers / cookies
    # ============================================================
    SECURITY_HEADERS = {
        "Strict-Transport-Security": ("missing-hsts", "HSTS header missing", "medium",
                                      "Add: Strict-Transport-Security: max-age=31536000;"
                                      " includeSubDomains"),
        "Content-Security-Policy": ("missing-csp", "CSP header missing", "medium",
                                    "Define a Content-Security-Policy."),
        "X-Content-Type-Options": ("missing-xcto", "X-Content-Type-Options missing",
                                   "low", "Set: X-Content-Type-Options: nosniff"),
        "X-Frame-Options": ("missing-xfo", "X-Frame-Options / frame-ancestors missing",
                            "low", "Set X-Frame-Options: DENY or CSP frame-ancestors 'none'"),
        "Referrer-Policy": ("missing-referrer", "Referrer-Policy missing", "info",
                            "Set Referrer-Policy: strict-origin-when-cross-origin"),
        "Permissions-Policy": ("missing-perms-policy", "Permissions-Policy missing",
                               "info", "Restrict geolocation/camera/mic via Permissions-Policy"),
    }

    def mod_headers(self):
        self.log("— [4/10] HTTP headers & cookies")
        html_body, final_url = self._root_html()
        if html_body is None:
            self.add(Finding("HTTP", "unreachable", "Site unreachable over HTTP(S)",
                             "info", 60, evidence="GET / failed"))
            return
        r = self._root_response
        if r is None:
            return
        h = {k.lower(): v for k, v in r.headers.items()}
        for hdr, (nid, title, sev, fix) in self.SECURITY_HEADERS.items():
            if hdr.lower() in h:
                continue
            if hdr == "X-Frame-Options" and "frame-ancestors" in \
                    h.get("content-security-policy", "").lower():
                continue
            f = Finding("Headers", nid, title, sev, 85,
                        evidence=f"Final URL: {r.url} | status {r.status_code}",
                        remediation=fix, cwe="CWE-693",
                        description="Security header absent on HTML response.")
            self.verify_finding(f, r.url, lambda rr, hd=hdr:
                                hd.lower() not in {k.lower() for k in rr.headers})
            self.add(f)
        # cookie hygiene — parse raw Set-Cookie strings (authoritative;
        # requests' jar can drop attributes/duplicates)
        import http.cookies as _hc
        setc = [v for k, v in r.headers.items() if k.lower() == "set-cookie"]
        seen_ck = set()
        for raw in setc:
            try:
                mc = _hc.SimpleCookie(raw)
            except _hc.CookieError:
                continue
            for name in mc:
                if name in seen_ck:
                    continue
                seen_ck.add(name)
                low_raw = raw.lower()
                probs = []
                if "httponly" not in low_raw:
                    probs.append("HttpOnly")
                if "secure" not in low_raw:
                    probs.append("Secure")
                if "samesite" not in low_raw:
                    probs.append("SameSite")
                if probs:
                    self.add(Finding(
                        "Cookies", f"cookie-{name}",
                        f"Cookie '{name}' missing {', '.join(probs)}",
                        "medium" if "Secure" in probs and self.target.startswith("https")
                        else "low", 85,
                        verified=True, evidence=raw[:200],
                        remediation="Set HttpOnly; Secure; SameSite=Lax/Strict.",
                        cwe="CWE-1004"))
        server = h.get("server", "")
        xpn = h.get("x-powered-by", "")
        if re.search(r"\d+\.\d+", server):
            self.add(Finding("Headers", "server-version", "Server version disclosed",
                             "low", 95, verified=True, evidence=f"Server: {server}",
                             remediation="Hide version tokens.", cwe="CWE-200"))
        if xpn:
            self.add(Finding("Headers", "x-powered-by", "X-Powered-By disclosure",
                             "low", 95, verified=True, evidence=xpn,
                             remediation="Remove the header.", cwe="CWE-200"))
        if "strict-transport-security" in h:
            m = re.search(r"max-age=(\d+)", h["strict-transport-security"])
            if m and int(m.group(1)) < 31536000:
                self.add(Finding("Headers", "weak-hsts", "Short HSTS max-age",
                                 "low", 90, verified=True,
                                 evidence=h["strict-transport-security"],
                                 remediation="Use max-age >= 6 months."))
        if re.search(r"(?i)<title>\s*index of", html_body[:3000]):
            self.add(Finding("Exposure", "dir-listing", "Directory listing enabled",
                             "medium", 90, verified=True, evidence=r.url,
                             remediation="Disable autoindex.", cwe="CWE-548"))
        errm = re.search(r"(?i)(stack trace|traceback \(most recent call last\)|"
                        r"warning\[\d+\]:|Notice: Undefined|SQL syntax.*?(?:MySQL|MariaDB)|"
                        r"ORA-\d{5}|PG::Error|Microsoft OLE DB Provider)",
                        html_body[:100_000])
        if errm:
            self.add(Finding("Exposure", "verbose-errors",
                             "Application error detail leaked in HTML", "medium", 80,
                             evidence=_html_mod.unescape(errm.group(0))[:120],
                             remediation="Disable display_errors; log server-side only.",
                             cwe="CWE-209"))

    # ============================================================
    # MODULE 5 — CORS policy (OPTIONS preflight OBSERVATION only)
    # ============================================================
    def mod_cors(self):
        self.log("— [5/10] CORS policy observation")
        if not HAVE_REQUESTS:
            return
        try:
            self.throttle.wait()
            r = self.session.options(self.target + "/", timeout=8,
                                     headers={"Origin": "https://example.invalid"})
            self.stats["requests"] += 1
            acao = r.headers.get("access-control-allow-origin", "")
            acac = r.headers.get("access-control-allow-credentials", "").lower()
            if acao == "*" and acac == "true":
                self.add(Finding("CORS", "cors-star-creds",
                                 "CORS: wildcard origin WITH credentials",
                                 "high", 80, verified=True,
                                 evidence=f"ACAO={acao}; ACAC={acac}",
                                 remediation="Never combine wildcard origin with "
                                             "credentials.", cwe="CWE-942"))
            elif acao == "null" and acac == "true":
                self.add(Finding("CORS", "cors-null",
                                 "CORS allows Origin: null with credentials",
                                 "high", 80, verified=True,
                                 evidence="ACAO=null; ACAC=true", cwe="CWE-942"))
            elif acao and acao not in ("*", self.host) and acao.startswith("http"):
                self.add(Finding("CORS", "cors-foreign", "Cross-origin access granted",
                                 "info", 70, verified=True, evidence=f"ACAO={acao}"))
        except requests.RequestException:
            pass

    # ============================================================
    # MODULE 6 — Exposure sweep (safe embedded wordlists, GET only)
    # ============================================================
    def mod_exposure(self):
        wl_admin = load_embedded_wordlist(WL_ADMIN_PANELS, 120)
        wl_sens = load_embedded_wordlist(WL_SENSITIVE_FILES, 150)
        wl_backup = load_embedded_wordlist(WL_BACKUP_PATHS, 60)
        wl_vc = load_embedded_wordlist(WL_VERSION_CONTROL, 50)
        # drop anything whose PURPOSE is to hold secrets — we report on
        # public artifacts only (fingerprints never record secret values)
        sens_filtered = [p for p in wl_sens if not any(
            x in p.lower() for x in (".env", "config", "settings", ".ini",
                                     ".yml", ".yaml", "database", ".db",
                                     "dump", ".sql", "shadow", "passwd",
                                     ".log", "backup", ".bak", ".zip",
                                     ".tar", ".gz", ".htaccess", "web.config"))]
        candidates = (SAFE_EXPOSURE_PATHS + wl_vc[:30] + wl_backup[:30] +
                      wl_admin[:80] + sens_filtered[:60])
        uniq = list(dict.fromkeys(candidates))
        self.log(f"— [6/10] Exposure sweep ({len(uniq)} safe paths, GET only)")

        def probe(path: str):
            url = urljoin(self.target + "/", path.lstrip("/"))
            r = self.get(url, timeout=8)
            if r is None:
                return
            status = r.status_code
            body_head = r.content[:self.MAX_BODY_SCAN]
            ct = r.headers.get("content-type", "").lower()
            interesting = None
            if path.endswith(".git/HEAD") and b"ref: refs/" in body_head[:100]:
                interesting = "Git repository HEAD exposed"
            elif path.endswith(".git/config") and b"[core]" in body_head[:2000]:
                interesting = "Git config exposed"
            elif path.endswith("/xmlrpc.php") and b"XML-RPC works" in body_head:
                interesting = "WordPress XML-RPC active (pingback amplification risk)"
            elif path.endswith("/server-status") and b"Apache Server Status" in body_head:
                interesting = "Apache server-status public"
            elif path.endswith("/phpinfo.php") and b"phpinfo()" in body_head:
                interesting = "phpinfo() page publicly accessible"
            elif status == 200 and "text/html" in ct and re.search(
                    rb"(?i)<title>[^<]*(index of|directory listing)", body_head[:3000]):
                interesting = "Directory listing"
            if interesting:
                f = Finding("Exposure", "exposed-" + re.sub(r"\W+", "-", path)[:40],
                            interesting,
                            "high" if "git" in interesting.lower() or
                            "phpinfo" in interesting.lower() else "medium",
                            75, evidence=f"{url} -> HTTP {status}, {len(body_head)}B",
                            remediation="Restrict access / remove artifact.",
                            cwe="CWE-538")
                self.verify_finding(f, url, lambda rr: rr.status_code == status)
                self.add(f)
            elif status == 200 and "json" in ct:
                text = body_head.decode("utf-8", "replace")
                for fname, rx in FINGERPRINT_RE.items():
                    if rx.search(text):
                        f = Finding("Exposure", f"fingerprint-{fname}",
                                    f"Possible sensitive pattern ({fname}) in {path}",
                                    "critical", 60,
                                    evidence=f"{url} matched pattern '{fname}' "
                                             "(value NOT recorded)",
                                    remediation="Rotate exposed credentials; "
                                                "remove file.", cwe="CWE-538")
                        self.verify_finding(f, url, lambda rr: rr.status_code == 200)
                        self.add(f)

        with cf.ThreadPoolExecutor(max_workers=self.workers) as ex:
            list(ex.map(probe, uniq))

    # ============================================================
    # MODULE 7 — JS / HTML static review (the "new" part you asked for)
    #   • inline <script> blocks reviewed for dangerous constructs
    #   • same-origin external .js files fetched (GET) & reviewed
    #   • source-map (.map) leak detection — original sources exposure
    #   • CDN scripts without Subresource Integrity (SRI)
    #   • http:// form actions / mixed content inside markup
    # Nothing is executed. Pure textual review, like reading an X-ray.
    # ============================================================
    def mod_js_review(self):
        self.log("— [7/10] JavaScript & HTML static review")
        html_body, final_url = self._root_html()
        if html_body is None:
            return

        # 7a. inline script blocks
        inline_blocks = re.findall(
            r"<script(?![^>]*\bsrc=)[^>]*>(.*?)</script>", html_body,
            re.S | re.I)
        joined_inline = "\n;\n".join(inline_blocks)[:400_000]
        for pid, title, sev, ev, fix in analyze_js_source(joined_inline, "inline<script>"):
            f = Finding("JS-Review", pid, title, sev, 70, evidence=ev,
                        remediation=fix, cwe=pid and "CWE-79")
            f.cwe = fix.split("[")[-1].rstrip("]") if "[" in fix else ""
            self.add(f)

        # 7b. dangerous HTML constructs in the markup itself
        if FORM_ACTION_HTTP_RE.search(html_body):
            m = FORM_ACTION_HTTP_RE.search(html_body)
            self.add(Finding("JS-Review", "form-http-action",
                             "Form submits over cleartext http://", "medium", 85,
                             evidence=m.group(0)[:120],
                             remediation="Point form actions at https://.",
                             cwe="CWE-319"))
        if INLINE_DEBUGGER_RE.search(html_body):
            self.add(Finding("JS-Review", "inline-debugger",
                             "'debugger' statement in inline script", "info", 80,
                             evidence="debugger found inside <script>",
                             remediation="Strip debug statements before deploy.",
                             cwe="CWE-489"))
        genm = GENERATOR_RE.search(html_body)
        if genm:
            self.add(Finding("CMS", "generator",
                             f"Generator disclosed: {genm.group(1)}",
                             "low", 95, verified=True, evidence=genm.group(1),
                             remediation="Remove generator meta tag.", cwe="CWE-200"))

        # 7c. external same-origin scripts — fetch & review (GET only)
        srcs = [s for s in SRC_JS_RE.findall(html_body)]
        reviewed = 0
        cdn_no_sri = []
        for tag in re.finditer(r"<script[^>]+src=[\"']([^\"']+)[\"'][^>]*>",
                               html_body, re.I):
            url_raw = tag.group(1)
            full = urljoin(final_url or self.target + "/", url_raw)
            host = urlparse(full).hostname or ""
            if host != self.host:
                if host in CDN_HOSTS and not SRI_RE.search(tag.group(0)):
                    cdn_no_sri.append(url_raw)
                continue                     # never leave the target's origin
            if reviewed >= self.MAX_JS_FILES:
                break
            r = self.get(full, timeout=10)
            if r is None or r.status_code != 200:
                continue
            if "javascript" not in r.headers.get("content-type", "").lower() \
                    and not full.endswith((".js", ".mjs")):
                continue
            reviewed += 1
            js_text = r.text[:400_000]
            for pid, title, sev, ev, fix in analyze_js_source(js_text, url_raw):
                f = Finding("JS-Review", pid, title, sev, 75,
                            evidence=ev, remediation=fix)
                f.cwe = fix.split("[")[-1].rstrip("]") if "[" in fix else ""
                self.add(f)
            # source map leak check
            smap = sourcemap_url(js_text)
            if smap:
                map_url = urljoin(full, smap)
                if urlparse(map_url).hostname == self.host:
                    rm = self.get(map_url, timeout=10)
                    if rm is not None and rm.status_code == 200 and len(rm.content) > 50:
                        try:
                            mj = json.loads(rm.content[:2_000_000].decode(
                                "utf-8", "replace"))
                            nsrc = len(mj.get("sources", []))
                            has_content = bool(mj.get("sourcesContent"))
                            self.add(Finding(
                                "JS-Review", "sourcemap-public",
                                f"Source map publicly downloadable ({url_raw}.map)",
                                "high" if has_content else "medium", 90,
                                evidence=f"{map_url} → {nsrc} original sources, "
                                         f"'sourcesContent' {'PRESENT' if has_content else 'absent'}",
                                remediation="Do not ship .map files to production or "
                                            "protect them behind auth.",
                                cwe="CWE-540"))
                        except Exception:
                            self.add(Finding("JS-Review", "sourcemap-present",
                                             f"Source map reference in {url_raw}",
                                             "info", 60, evidence=map_url))

        if cdn_no_sri:
            self.add(Finding("JS-Review", "cdn-no-sri",
                             f"CDN scripts loaded without SRI integrity attribute "
                             f"({len(cdn_no_sri)} file(s))",
                             "low", 85, verified=True,
                             evidence=", ".join(cdn_no_sri[:5]),
                             remediation="Add crossorigin + integrity (SRI) or self-host.",
                             cwe="CWE-353"))

    # ============================================================
    # MODULE 8 — WordPress / CMS passive fingerprinting
    # ============================================================
    def mod_cms(self):
        self.log("— [8/10] CMS fingerprinting (passive)")
        html_body, _ = self._root_html()
        if html_body is None:
            return
        wp = ("wp-content" in html_body) or ("wp-includes" in html_body)
        if wp:
            ver = ""
            rr = self.get(urljoin(self.target + "/", "readme.html"))
            if rr is not None and rr.status_code == 200:
                m = re.search(r"WordPress[^0-9]*([0-9]+\.[0-9.]+)", rr.text[:5000])
                ver = m.group(1) if m else ""
            self.add(Finding("CMS", "wordpress",
                             "WordPress detected" + (f" v{ver}" if ver else ""),
                             "info", 90, verified=True,
                             evidence=f"wp-content markers; readme version="
                                      f"{ver or 'n/a'}"))
            j = self.get(urljoin(self.target + "/", "wp-json/wp/v2/types"))
            if j is not None and j.status_code == 200:
                self.add(Finding("CMS", "wp-rest-open",
                                 "WP REST API responds (user enumeration possible)",
                                 "low", 70, evidence="/wp-json/wp/v2 responded",
                                 remediation="Limit REST API access for guests.",
                                 cwe="CWE-200"))
        for marker, name in (("drupal", "Drupal"), ("typo3", "TYPO3"),
                             ("/joomla", "Joomla"), ("shopify", "Shopify"),
                             ("wixstatic", "Wix"), ("squarespace", "Squarespace")):
            if marker in html_body.lower():
                self.add(Finding("CMS", f"cms-{name.lower()}",
                                 f"{name} fingerprint markers present", "info", 70,
                                 evidence=f"'{marker}' seen in HTML"))
                break

    # ============================================================
    # MODULE 9 — robots.txt / sitemap: READ ONLY (never enqueued)
    # ============================================================
    def mod_robots(self):
        self.log("— [9/10] robots.txt / sitemap inspection (read-only)")
        for name in ("robots.txt", "sitemap.xml"):
            url = urljoin(self.target + "/", name)
            r = self.get(url)
            if r is None or r.status_code != 200:
                continue
            if name == "robots.txt":
                lines = [l.strip() for l in r.text.splitlines() if l.strip()]
                disallows = [l for l in lines if l.lower().startswith("disallow")]
                self.add(Finding("Recon", "robots-found",
                                 f"robots.txt present ({len(disallows)} Disallow rules)",
                                 "info", 100, verified=True,
                                 evidence="; ".join(disallows)[:400],
                                 description="NOTE: listed paths were NOT crawled "
                                             "(respecting robots directives)."))
                for l in disallows:
                    p = l.split(":", 1)[-1].strip()
                    if re.search(r"(?i)(admin|backup|\.env|\.git|config|private|"
                                 r"internal|staging|dump)", p):
                        f = Finding("Recon", "robots-sensitive-entry",
                                    f"robots.txt discloses sensitive path: {p}",
                                    "medium", 85, evidence=l[:200],
                                    remediation="Use authentication instead of "
                                                "hiding via robots.", cwe="CWE-200")
                        self.verify_finding(f, url, lambda rr: rr.status_code == 200)
                        self.add(f)
            else:
                urls = re.findall(r"<loc>(.*?)</loc>", r.text)[:50]
                self.add(Finding("Recon", "sitemap-found",
                                 f"sitemap.xml present ({len(urls)} URLs)",
                                 "info", 100, verified=True,
                                 evidence="; ".join(urls)[:400]))

    # ============================================================
    # MODULE 10 — Transport hygiene: mixed content & HTTP→HTTPS redirect
    # ============================================================
    def mod_mixed(self):
        self.log("— [10/10] mixed content & redirects")
        html_body, _ = self._root_html()
        if html_body is None:
            return
        if (self._final_url or self.target).startswith("https://"):
            http_refs = re.findall(
                r'(?:src|href)=["\'](http://[\'"]?[^"\']+)', html_body[:200_000])
            if http_refs:
                f = Finding("Transport", "mixed-content",
                            "Mixed content: http:// resources on https page",
                            "medium", 75,
                            evidence=", ".join(http_refs[:5]),
                            remediation="Serve all assets over TLS.", cwe="CWE-311")
                self.verify_finding(
                    f, self._final_url or (self.target + "/"),
                    lambda rr: bool(re.findall(
                        r'(?:src|href)=["\']http://', rr.text[:200_000])))
                self.add(f)
        else:
            # HTTP target: check whether an HTTPS counterpart is available at
            # all — if it is and the site still serves plain HTTP that means
            # no automatic redirect to TLS.
            alt = urlunparse(("https", self.parsed.netloc, "/", "", "", ""))
            rh = self.get(alt, timeout=6)
            if rh is None:
                self.add(Finding("Transport", "no-https",
                                 "HTTPS counterpart unreachable",
                                 "high", 80, verified=True,
                                 evidence=f"{alt} did not respond; site served "
                                          "over cleartext HTTP only",
                                 remediation="Deploy a TLS certificate and "
                                             "redirect HTTP -> HTTPS.",
                                 cwe="CWE-319"))

    # ============================================================
    # CVE intelligence (READ-ONLY advisory hint — no exploit anything)
    # ============================================================
    def mod_cve(self, components: List[Tuple[str, str]]):
        if not components:
            return
        self.log(f"— CVE intelligence for {len(components)} component(s)")
        for name, ver in components[:5]:
            self.add(Finding(
                "CVE", f"cve-watch-{re.sub(r'\W+', '-', name)}",
                f"Review advisories: {name} {ver}",
                "info", 55,
                description="Open-source component detected. Check "
                            "github.com/github/advisory-database for known CVEs "
                            f"affecting {name} <= {ver}. This scanner does NOT "
                            "attempt exploitation.",
                remediation="Update to latest stable release."))

    # ============================================================
    # Orchestration
    # ============================================================
    def run(self) -> List[Finding]:
        t0 = time.time()
        self.log(f"Scanning {self.target} | rate<= {self.throttle.rate} rps | "
                 f"workers={self.workers} | verify={self.verify_enabled}")
        steps = [self.mod_dns, self.mod_headers, self.mod_cors, self.mod_tls,
                 self.mod_ports, self.mod_js_review, self.mod_robots,
                 self.mod_cms, self.mod_exposure, self.mod_mixed]
        for i, step in enumerate(steps, 1):
            if self.cancelled():
                break
            try:
                step()
            except Exception as e:
                self.log(f"module error [{step.__name__}]: {e}")
            self.progress(i / len(steps))
        comps = []
        for f in self.findings:
            if f.category == "CMS" and "WordPress detected" in f.title:
                m = re.search(r"v(\d[\d.]+)", f.title)
                comps.append(("wordpress", m.group(1) if m else "unknown"))
            if f.name == "server-version":
                comps.append((f.evidence.split(":")[-1].strip().split("/")[0]
                              or "server", "see-evidence"))
        try:
            self.mod_cve(comps)
        except Exception as e:
            self.log(f"module error [cve]: {e}")
        self.duration = time.time() - t0
        self.log(f"Done in {self.duration:.1f}s | "
                 f"{self.stats['requests']} requests issued | read-only")
        self.progress(1.0)
        return self.findings


