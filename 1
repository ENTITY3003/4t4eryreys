                    help="run the full local test suite and exit")
    ap.add_argument("--gui-nogate", action="store_true",
                    help="skip admin/root gate (dev/testing only)")
    args = ap.parse_args()

    if args.selftest:
        return run_selftest()

    if not HAVE_REQUESTS:
        print("ERROR: the 'requests' package is required.\n"
              "       pip install requests   (then re-run)")
        return 2

    if not args.gui_nogate and not is_admin():
        print("=" * 64)
        if os.name == "nt":
            print("ADMIN RIGHTS REQUIRED.\n"
                  "Right-click your terminal → 'Run as administrator', then:\n"
                  f"    python {os.path.basename(sys.argv[0])}")
        else:
            print("ROOT RIGHTS REQUIRED.\n"
                  "Re-run with sudo:\n"
                  f"    sudo python3 {os.path.basename(sys.argv[0])}")
        print("(use --gui-nogate to bypass this gate for development)")
        print("=" * 64)
        return 3

    if args.cli:
        return run_cli(args.cli, args.rps, args.workers,
                       not args.no_verify, args.deep_ports, args.out)

    try:
        import tkinter as tk
    except ImportError:
        print("Tkinter unavailable — use --cli mode instead:\n"
              f"  sudo python3 {os.path.basename(sys.argv[0])} --cli https://target")
        return 2
    root = tk.Tk()
    DentistGUI(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
