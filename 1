def classify_bytes(head: bytes) -> Optional[Tuple[str, str]]:
    """Safe static classification: returns (label, description) of the
    FIRST matching magic signature. No execution, no unpacking."""
    for label, sig, desc in MAGIC_SIGNS:
        if head.startswith(sig):
            return label, desc
    if head[:2] == b"\x1f\x9d" or head[:2] == b"\x1fa0":
        return "compress-legacy", "Legacy compress(.Z)"
    if b"<%=" in head[:200] or b"<?=" in head[:200]:
        return "jsp-or-asp", "JSP/ASP page fragment"
    if re.match(rb"^\s*#!\s*/usr/bin/(env\s+)?(python|perl|php|node|bash)",
                head[:64]):
        return "shebang-script", "Executable script (shebang)"
    if re.match(rb"^\s*(<html|<!doctype html)", head[:200], re.I):
        return "html", "HTML document"
    if re.match(rb"^\s*[{[]", head[:8]):
        return "json-ish", "Looks like JSON"
    if head[:5] == b"%!PS-":
        return "postscript", "PostScript file"
    return None


def detect_waf(html_body: str, headers: Dict[str, str]) -> Optional[str]:
    """Purely observational WAF fingerprint from response headers/body."""
    joined_h = "\n".join(f"{k.lower()}: {v.lower()}"
                         for k, v in headers.items())
    low_body = (html_body or "")[:8000].lower()
    for name, sigs in WAF_FINGERPRINTS:
        for sig in sigs:
            if sig in joined_h:
                return name
            if len(sig) > 6 and sig.replace(": ", "") in low_body:
                return name
    if "captcha-delivery.com" in low_body or "cf-browser-verification" in low_body:
        return "Cloudflare"
    if "attention! required subscription" in low_body:
        return "HostGuard/Sucuri-block"
    return None


def looks_like_cdn(ip: str, headers: Dict[str, str]) -> Optional[str]:
    """CDN guess from header hints + well-known provider prefixes."""
    sv = (headers.get("server") or "").lower()
    via = (headers.get("via") or "").lower()
    if "cloudflare" in sv:
        return "Cloudflare"
    if "cloudfront" in via or "cloudfront" in sv:
        return "AWS CloudFront"
    if "akamai" in via or "akamai" in sv:
        return "Akamai"
    if "goog" in sv or "gstatic" in via:
        return "Google"
    if "fastly" in via:
        return "Fastly"
    for prov, prefixes in CDN_IP_PREFIXES.items():
        if any(ip.startswith(p) for p in prefixes):
            return prov
    return None


def extract_login_forms(html: str, base_url: str) -> List[Dict[str, Any]]:
    """Parse HTML forms heuristically: action URL, method, field names,
    whether password inputs exist. Pure regex — no parser dependency."""
    forms: List[Dict[str, Any]] = []
    for m in re.finditer(r"<form\b[^>]*>(.*?)</form>", html,
                         re.I | re.S):
        tag_head = m.group(0)[:m.start(1) - m.start(0) + len(m.group(0))]
        inner = m.group(1)
        head = tag_head.split(">", 1)[0]
        action_m = re.search(r"action\s*=\s*[\"']([^\"']*)[\"']", head, re.I)
        method_m = re.search(r"method\s*=\s*[\"']([^\"']*)[\"']", head, re.I)
        action = action_m.group(1) if action_m else base_url
        method = (method_m.group(1) if method_m else "GET").upper()
        fields: List[Dict[str, str]] = []
        for inp in re.finditer(r"<input\b[^>]*>", inner, re.I):
            attrs = parse_attrs(inp.group(0))
            fields.append({
                "tag": "input",
                "type": attrs.get("type", "text").lower(),
                "name": attrs.get("name", ""),
                "autocomplete": attrs.get("autocomplete", "").lower(),
            })
        for sel in re.finditer(r"<select\b[^>]*>", inner, re.I):
            attrs = parse_attrs(sel.group(0))
            fields.append({"tag": "select", "type": "select",
                           "name": attrs.get("name", "")})
        has_pass = any(f["type"] == "password" for f in fields)
        user_hint = any(
            re.search(r"(user|login|email|account|uname)",
                      f.get("name", ""), re.I)
            for f in fields if f["tag"] == "input" and f["type"] != "password")
        is_login = has_pass and (user_hint or method == "POST")
        forms.append({
            "action": urljoin(base_url, action),
            "method": method,
            "fields": fields,
            "has_password": has_pass,
            "looks_like_login": bool(is_login),
        })
    return forms


def parse_attrs(tag_head: str) -> Dict[str, str]:
    """Small attribute extractor shared with existing code paths."""
    attrs: Dict[str, str] = {}
    for m in re.finditer(r"([a-zA-Z_:][-a-zA-Z0-9_:.]*)\s*=\s*"
                         r"(?:\"([^\"]*)\"|'([^']*)'|([^\s\"'>]+))",
                         tag_head):
        key = m.group(1).lower()
        val = m.group(2) or m.group(3) or m.group(4) or ""
        attrs[key] = val
    return attrs


def entropy_of(s: str) -> float:
    """Shannon entropy per char — used to flag random-looking secrets."""
    import math
    from collections import Counter
    if not s:
        return 0.0
    c = Counter(s)
    n = len(s)
    return round(-sum((v / n) * math.log2(v / n) for v in c.values()), 3)


def mask_secret(val: str) -> str:
    """Redact secret values for evidence: keep first 4 chars only."""
    if len(val) <= 6:
        return "*" * len(val)
    return val[:4] + "*" * max(4, len(val) - 4)


def split_tokens(user_input: str) -> List[str]:
    """Split free-text credentials into candidate tokens (for default-cred
    comparison against operator-supplied creds)."""
    toks = re.split(r"[^A-Za-z0-9@._\-]+", user_input or "")
    return [t for t in toks if t][:12]


def levenshtein(a: str, b: str) -> int:
    """Standard DP edit distance (small strings only — used on ≤64-char
    credential comparisons, so O(n*m) is trivial)."""
    a, b = a[:64], b[:64]
    if a == b:
        return 0
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1,
                           prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


