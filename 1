OPENCVE_SEARCH = "https://app.opencve.io/api/cve/"


def opencve_search(cve_id: str, throttle: Optional[Throttle] = None
                   ) -> Optional[Dict[str, Any]]:
    """Try OpenCVE search API (may be blocked by its WAF — that itself is
    recorded as an observation, never retried aggressively)."""
    if throttle is not None:
        throttle.wait()
    try:
        s = requests.Session()
        s.headers.update({"User-Agent": UA, "Accept": "application/json"})
        r = s.get(OPENCVE_SEARCH + cve_id, timeout=10.0)
        if r.status_code == 200:
            return r.json()
        return {"blocked": True, "status": r.status_code}
    except Exception:
        return None


