# v4 — nuclei-templates advisory corpus loader (GitHub mirrors).
# We download ONLY the lightweight index (file list) plus a curated set
# of matcher keywords. The scan NEVER executes template logic; instead
# each template's id/name/severity/tags become ADVISORY entries matched
# against detected components (fingerprints from mod_cms/mod_headers).
# ─────────────────────────────────────────────────────────────────────
def load_nuclei_advisories(throttle: Optional[Throttle] = None,
                           limit: int = 1200) -> List[Dict[str, Any]]:
    advs: List[Dict[str, Any]] = []
    for repo, branch, sub, cat in NUCLEI_TEMPLATE_SOURCES:
        entries = github_tree_entries(repo, branch, sub, throttle=throttle)
        for e in entries:
            if e.get("type") != "file":
                continue
            name = e.get("name", "")
            if not name.endswith(".yaml"):
                continue
            advs.append({"category": cat, "template": name[:-5],
                         "repo": repo, "path": e.get("path", ""),
                         "html_url": e.get("html_url", "")})
            if len(advs) >= limit:
                return advs
    return advs


def advisories_for_component(component: str, version: str,
                             advs: List[Dict[str, Any]],
                             cap: int = 12) -> List[Dict[str, Any]]:
    """Match advisory templates against a component name (substring)."""
    comp = component.lower()
    hits = [a for a in advs if comp and comp in (a["template"] + a["path"]).lower()]
    return hits[:cap]


# ═══════════════════════════════════════════════════════════════════════
# Embedded PDF report writer — pure Python (no reportlab needed).
# Produces a valid single/multi-page A4 PDF with Helvetica text,
# severity-colored badges and tables drawn as filled rectangles.
# ═══════════════════════════════════════════════════════════════════════
_SEV_RGB = {"critical": (0.50, 0.11, 0.11), "high": (0.73, 0.11, 0.11),
            "medium": (0.85, 0.47, 0.06), "low": (0.15, 0.39, 0.86),
            "info": (0.40, 0.46, 0.55)}


class _PdfPage:
    def __init__(self):
        self.ops: List[str] = []
        self.y = 0.0   # current cursor (from top)

    def emit(self, s: str):
        self.ops.append(s)


class MiniPdf:
    PAGE_W, PAGE_H = 595.28, 841.89          # A4 points
    MARGIN = 42.0

    def __init__(self, title: str):
        self.title = title
        self.pages: List[_PdfPage] = []
        self.cur = None
        self.new_page()

    # ---- low-level drawing ----
    def new_page(self):
        if self.cur is not None and self.cur.ops:
            pass
        self.cur = _PdfPage()
        self.cur.y = self.PAGE_H - self.MARGIN
        self.pages.append(self.cur)

    def _ensure(self, need: float):
        if self.cur.y - need < self.MARGIN:
            self.new_page()

    def text(self, s: str, size: float = 9, bold: bool = False,
             rgb=(0.08, 0.09, 0.12), dy: Optional[float] = None,
             x: Optional[float] = None, wrap_width: float = 511.0):
        s = re.sub(r"[\r\n\t]+", " ", str(s))
        font = "/F2" if bold else "/F1"
        # simple word-wrap by approximate char width
        cw = size * 0.50
        maxchars = max(10, int(wrap_width / cw))
        words, lines, cur = s.split(" "), [], ""
        for w in words:
            if len(cur) + len(w) + 1 <= maxchars:
                cur = (cur + " " + w).strip()
            else:
                if cur:
                    lines.append(cur)
                cur = w[:maxchars]
        if cur:
            lines.append(cur)
        lh = size * 1.35
        for ln in lines:
            self._ensure(lh)
            safe = _pdf_escape(ln)
            px = x if x is not None else self.MARGIN
            py = self.cur.y
            self.cur.emit(f"BT {font} {size} Tf {' '.join(f'{c:.3f}' for c in rgb)} rg "
                          f"{px:.2f} {py:.2f} Td ({safe}) Tj ET")
            self.cur.y -= lh

    def badge(self, label: str, rgb):
        self._ensure(16)
        py = self.cur.y - 11
        w = len(label) * 6.2 + 14
        self.cur.emit(f"{rgb[0]:.3f} {rgb[1]:.3f} {rgb[2]:.3f} rg "
                      f"{self.MARGIN:.2f} {py:.2f} {w:.2f} 13 re f")
        self.text(label.upper(), 8, bold=True, rgb=(1, 1, 1),
                  dy=0, x=self.MARGIN + 7)
        self.cur.y = py + 13 - 13  # align

    def hrule(self):
        self._ensure(6)
        self.cur.emit(f"0.88 0.90 0.93 rg {self.MARGIN:.2f} {self.cur.y - 2:.2f} "
                      f"{self.PAGE_W - 2 * self.MARGIN:.2f} 0.8 re f")
        self.cur.y -= 8

    def spacer(self, h: float):
        self.cur.y -= h

    # ---- output ----
    def save(self, path: str):
        objs: List[bytes] = []

        def add(b: bytes) -> int:
            objs.append(b)
            return len(objs)     # 1-based object number

        catalog_id = add(b"")    # placeholder 1
        pages_id = add(b"")      # placeholder 2
        f1 = add(b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>")
        f2 = add(b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>")
        info_id = add(("<< /Producer (H303 Dentist " + VERSION +
                        ") /Title (" + _pdf_escape(self.title) + ") >>").encode())

        page_ids = []
        content_ids = []
        for pg in self.pages:
            stream = "\n".join(pg.ops).encode("latin-1", "replace")
            cid = add(b"<< /Length " + str(len(stream)).encode() +
                      b" >>\nstream\n" + stream + b"\nendstream")
            content_ids.append(cid)
        for cid in content_ids:
            pid = add(("<< /Type /Page /Parent %d 0 R /MediaBox [0 0 %.2f %.2f] "
                       "/Resources << /Font << /F1 %d 0 R /F2 %d 0 R >> >> "
                       "/Contents %d 0 R >>" % (pages_id, self.PAGE_W,
                                                self.PAGE_H, f1, f2, cid)
                       ).encode())
            page_ids.append(pid)

        kids = " ".join(f"{i} 0 R" for i in page_ids)
        objs[pages_id - 1] = (f"<< /Type /Pages /Count {len(page_ids)} "
                              f"/Kids [{kids}] >>").encode()
        objs[catalog_id - 1] = (f"<< /Type /Catalog /Pages {pages_id} 0 R >>").encode()

        out = io.BytesIO()
        out.write(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
        offsets = []
        for i, body in enumerate(objs, start=1):
            offsets.append(out.tell())
            out.write(f"{i} 0 obj\n".encode() + body + b"\nendobj\n")
        xref_pos = out.tell()
        n = len(objs) + 1
        out.write(f"xref\n0 {n}\n".encode())
        out.write(b"0000000000 65535 f \n")
        for off in offsets:
            out.write(f"{off:010d} 00000 n \n".encode())
        out.write((f"trailer\n<< /Size {n} /Root {catalog_id} 0 R "
                   f"/Info {info_id} 0 R >>\nstartxref\n{xref_pos}\n%%EOF\n").encode())
        with open(path, "wb") as fh:
            fh.write(out.getvalue())
        return path


def _pdf_escape(s: str) -> str:
    s = str(s)
    s = "".join(ch if 32 <= ord(ch) < 127 else "?" for ch in s)
    return s.replace("\\", r"\\").replace("(", r"\(").replace(")", r"\)")


def build_pdf(findings: List[Dict], meta: Dict, log_lines: List[str],
              out_path: str) -> str:
    pdf = MiniPdf(f"H303 Dentist Report - {meta.get('target','')}")
    pdf.text("H303 DENTIST SCANNER", 20, bold=True, rgb=(0.06, 0.09, 0.17))
    pdf.text("Non-Destructive Security Diagnostic Report", 11,
             rgb=(0.35, 0.40, 0.50))
    pdf.spacer(6)
    pdf.text(f"Target: {meta.get('target','')}", 9, bold=True)
    pdf.text(f"Generated: {meta.get('generated','')}   |   "
             f"Duration: {float(meta.get('duration', 0)):.1f}s   |   "
             f"Requests issued (read-only): {meta.get('requests', 0)}   |   "
             f"Engine: {VERSION}", 8)
    pdf.text("All medium+ findings were independently re-verified before "
             "inclusion. This scan sent no payloads and caused no state change.",
             8, rgb=(0.30, 0.35, 0.42))
    pdf.hrule()

    counts: Dict[str, int] = {}
    for f in findings:
        counts[f["severity"]] = counts.get(f["severity"], 0) + 1
    pdf.text("Executive summary", 13, bold=True)
    for sev in ("critical", "high", "medium", "low", "info"):
        pdf.badge(f"{sev}: {counts.get(sev, 0)}", _SEV_RGB[sev])
        pdf.spacer(2)
    pdf.spacer(8)

    ordered = sorted(findings, key=lambda f: -SEV_ORDER.get(f["severity"], 0))
    pdf.text(f"Findings ({len(ordered)})", 13, bold=True)
    pdf.hrule()
    if not ordered:
        pdf.text("No findings recorded.", 9)
    for i, f in enumerate(ordered, 1):
        sev = f["severity"]
        pdf.spacer(4)
        pdf.badge(sev, _SEV_RGB.get(sev, (0.4, 0.4, 0.4)))
        ver = "VERIFIED" if f.get("verified") else "unverified"
        pdf.text(f"{i}. {f['title']}", 10, bold=True)
        pdf.text(f"[{f['category']} | confidence {f.get('confidence',0)}% | {ver}"
                 + (f" | {f['cwe']}" if f.get('cwe') else "") + "]", 7.5,
                 rgb=(0.35, 0.40, 0.48))
        for k in ("description", "evidence", "remediation"):
            v = f.get(k) or ""
            if v:
                pdf.text(f"{k.capitalize()}: {v}", 8,
                         rgb=(0.15, 0.17, 0.22), x=MiniPdf.MARGIN + 10)
        pdf.text(f"Detected at: {f.get('timestamp_str','')}", 7,
                 rgb=(0.45, 0.48, 0.55), x=MiniPdf.MARGIN + 10)
        pdf.hrule()

    pdf.spacer(6)
    pdf.text("Appendix A - Live scan log", 12, bold=True)
    pdf.hrule()
    for line in log_lines[-500:]:
        pdf.text(line, 7, rgb=(0.25, 0.28, 0.34))
    return pdf.save(out_path)


