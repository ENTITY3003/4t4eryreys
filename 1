# CLI mode — sudo python3 h303_scanner.py --cli https://target
# ─────────────────────────────────────────────────────────────────────
def run_cli(target: str, rps: float, workers: int, verify: bool,
            deep: bool, out_prefix: Optional[str]) -> int:
    logs: List[str] = []
    sc = DentistScanner(target,
                        log=lambda m: (logs.append(m),
                                       print(f"  * {m}", flush=True)),
                        emit=lambda f: print(f"    [{f.severity:>8}] "
                                             f"{'V' if f.verified else ' '} "
                                             f"{f.category:<12} {f.title}"),
                        rps=rps, workers=workers, verify=verify,
                        deep_portscan=deep)
    fs = sc.run()
    ordered = sorted(fs, key=lambda x: -SEV_ORDER[x.severity])
    print("\n════════ SUMMARY ════════")
    for f in ordered:
        print(f"[{f.severity:>8}] conf={f.confidence:3}% "
              f"verified={'YES' if f.verified else 'no '} | {f.category}: "
              f"{f.title}")
    print(f"\n{len(fs)} findings | {sc.stats['requests']} requests | "
          f"{sc.duration:.1f}s | offsite-skipped={sc.stats['skipped']}")
    if out_prefix:
        meta = {"target": sc.target,
                "generated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "duration": sc.duration, "requests": sc.stats["requests"]}
        fd = [f.to_dict() for f in ordered]
        pdf_path = out_prefix + ".pdf"
        build_pdf(fd, meta, logs, pdf_path)
        with open(out_prefix + ".json", "w", encoding="utf-8") as fh:
            json.dump({"meta": meta, "findings": fd}, fh,
                      ensure_ascii=False, indent=2)
        print(f"Report written: {pdf_path} + {out_prefix}.json")
    return 0


